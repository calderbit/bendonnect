      do Result<&2, &1, String, Repeats>:
        r : List<&2, String> <- Pbr.read.repeated.string(v, f_names)
        return Repeats{f_packed_ints, f_unpacked_ints, r, f_blobs, f_longs, f_doubles, f_flags, f_colors, f_items}

def Repeats.apply.blobs(v: Pb.Value, m: Repeats) -> Result<&2, &1, String, Repeats>:
  match m:
    case Repeats{f_packed_ints, f_unpacked_ints, f_names, f_blobs, f_longs, f_doubles, f_flags, f_colors, f_items}:
      do Result<&2, &1, String, Repeats>:
        r : List<&2, List<&2, U32>> <- Pbr.read.repeated.bytes(v, f_blobs)
        return Repeats{f_packed_ints, f_unpacked_ints, f_names, r, f_longs, f_doubles, f_flags, f_colors, f_items}

