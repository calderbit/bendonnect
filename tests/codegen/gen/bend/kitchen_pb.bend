def Maps.f.labels(xs: List<&2, Maps.LabelsEntry>) -> List<&1, Pb.Field>:
  Pbr.field.repeated.message(3, Maps.f.labels.items(xs))

def Maps.f.flags.items(xs: List<&2, Maps.FlagsEntry>) -> List<&1, List<&1, Pb.Field>>:
  match xs:
    case Nil{}:
