      do Result<&2, &1, String, Repeats>:
        r : List<&2, U32> <- Pbr.read.repeated.int32(v, f_unpacked_ints)
        return Repeats{f_packed_ints, r, f_names, f_blobs, f_longs, f_doubles, f_flags, f_colors, f_items}

def Repeats.apply.names(v: Pb.Value, m: Repeats) -> Result<&2, &1, String, Repeats>:
  match m:
