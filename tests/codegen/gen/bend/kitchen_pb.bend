        r : List<&2, Maps.ColorsEntry> <- Pj.read.map(~Pb.Word64, ~U32, ~Maps.ColorsEntry, ~Pj.read.key.sint64, ~Color.read_json, ~Maps.ColorsEntry.mk, v)
        return (rest, Maps.set.colors(r, m))

def Maps.jf.colors(st: List<&1, String & Json.Val> & Maps) -> Result<&2, &1, String, List<&1, String & Json.Val> & Maps>:
