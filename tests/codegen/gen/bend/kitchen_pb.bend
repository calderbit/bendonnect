def Maps.j.counts.items(es: List<&2, Maps.CountsEntry>) -> List<&1, Bytes.Bytes & Json.Val>:
  match es:
    case Nil{}:
      Nil{}
    case Con{+e, t}:
      match e:
        case Maps.CountsEntry{k, v}:
          Con{Pj.entry(Pj.key.string(k), Pj.val.int64(v)), Maps.j.counts.items(t)}

def Maps.j.counts(es: List<&2, Maps.CountsEntry>, acc: List<&1, Bytes.Bytes & Json.Val>) -> List<&1, Bytes.Bytes & Json.Val>:
  Pj.put.map("counts", Maps.j.counts.items(es), acc)

