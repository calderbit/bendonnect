def Maps.to_json(m: Maps) -> Json.Val:
  match m:
    case Maps{f_counts, f_by_id, f_labels, f_flags, f_blobs, f_colors}:
      Pj.obj(Maps.j.colors(f_colors, Maps.j.blobs(f_blobs, Maps.j.flags(f_flags, Maps.j.labels(f_labels, Maps.j.by_id(f_by_id, Maps.j.counts(f_counts, Nil{})))))))

def Maps.jf.counts.k(t: Json.Val & List<&1, String & Json.Val>, m: Maps) -> Result<&2, &1, String, List<&1, String & Json.Val> & Maps>:
  match t:
    case Tuple{v, rest}:
      do Result<&2, &1, String, List<&1, String & Json.Val> & Maps>:
        r : List<&2, Maps.CountsEntry> <- Pj.read.map(~String, ~Pb.Word64, ~Maps.CountsEntry, ~Pj.read.key.string, ~Pj.read.int64, ~Maps.CountsEntry.mk, v)
        return (rest, Maps.set.counts(r, m))

def Maps.jf.counts(st: List<&1, String & Json.Val> & Maps) -> Result<&2, &1, String, List<&1, String & Json.Val> & Maps>:
  match st:
    case Tuple{kvs, m}:
      Maps.jf.counts.k(Pj.take(kvs, "counts", "counts"), m)

def Maps.jf.by_id.k(t: Json.Val & List<&1, String & Json.Val>, m: Maps) -> Result<&2, &1, String, List<&1, String & Json.Val> & Maps>:
