def Scalars.jf.f_bytes.k(t: Json.Val & List<&1, String & Json.Val>, m: Scalars) -> Result<&2, &1, String, List<&1, String & Json.Val> & Scalars>:
  match t:
    case Tuple{v, rest}:
      do Result<&2, &1, String, List<&1, String & Json.Val> & Scalars>:
        r : List<&2, U32> <- Pj.read.bytes(v)
        return (rest, Scalars.set.f_bytes(r, m))

def Scalars.jf.f_bytes(st: List<&1, String & Json.Val> & Scalars) -> Result<&2, &1, String, List<&1, String & Json.Val> & Scalars>:
  match st:
    case Tuple{kvs, m}:
      Scalars.jf.f_bytes.k(Pj.take(kvs, "fBytes", "f_bytes"), m)

def Scalars.jf.finish(st: List<&1, String & Json.Val> & Scalars) -> Scalars:
  match st:
    case Tuple{kvs, m}:
      m

def Scalars.from_json(v: Json.Val) -> Result<&2, &1, String, Scalars>:
  do Result<&2, &1, String, Scalars>:
    kvs : List<&1, String & Json.Val> <- Pj.fields(v)
    s1 : List<&1, String & Json.Val> & Scalars <- Scalars.jf.f_double((kvs, Scalars.default()))
    s2 : List<&1, String & Json.Val> & Scalars <- Scalars.jf.f_float(s1)
    s3 : List<&1, String & Json.Val> & Scalars <- Scalars.jf.f_int32(s2)
    s4 : List<&1, String & Json.Val> & Scalars <- Scalars.jf.f_int64(s3)
    s5 : List<&1, String & Json.Val> & Scalars <- Scalars.jf.f_uint32(s4)
    s6 : List<&1, String & Json.Val> & Scalars <- Scalars.jf.f_uint64(s5)
    s7 : List<&1, String & Json.Val> & Scalars <- Scalars.jf.f_sint32(s6)
    s8 : List<&1, String & Json.Val> & Scalars <- Scalars.jf.f_sint64(s7)
    s9 : List<&1, String & Json.Val> & Scalars <- Scalars.jf.f_fixed32(s8)
    s10 : List<&1, String & Json.Val> & Scalars <- Scalars.jf.f_fixed64(s9)
    s11 : List<&1, String & Json.Val> & Scalars <- Scalars.jf.f_sfixed32(s10)
    s12 : List<&1, String & Json.Val> & Scalars <- Scalars.jf.f_sfixed64(s11)
    s13 : List<&1, String & Json.Val> & Scalars <- Scalars.jf.f_bool(s12)
    s14 : List<&1, String & Json.Val> & Scalars <- Scalars.jf.f_string(s13)
    s15 : List<&1, String & Json.Val> & Scalars <- Scalars.jf.f_bytes(s14)
    return Scalars.jf.finish(s15)

def Scalars.encode_json(m: Scalars) -> Bytes.Bytes:
  Pj.encode(Scalars.to_json(m))

def Scalars.decode_json(b: Bytes.Bytes) -> Result<&2, &1, String, Scalars>:
  do Result<&2, &1, String, Scalars>:
    v : Json.Val <- Pj.parse(b)
    Scalars.from_json(v)

def Scalars.encode(+codec: P.Codec, m: Scalars) -> Bytes.Bytes:
  match codec:
    case P.Json{}:
      Scalars.encode_json(m)
    case P.Proto{}:
      Scalars.encode_proto(m)
    case P.Custom{name}:
      Bytes.new(0)

def Scalars.decode(+codec: P.Codec, b: Bytes.Bytes) -> Result<&1, &1, E.Error, Scalars>:
  match codec:
    case P.Json{}:
      lift_error(Scalars, Scalars.decode_json(b))
    case P.Proto{}:
      lift_error(Scalars, Scalars.decode_proto(b))
    case P.Custom{name}:
      Fail{E.new(Code.Unimplemented{}, "codec not supported: " ++ name)}

# ---------------------------------------------------------------- message Repeats

def Repeats.default() -> Repeats:
  Repeats{Nil{}, Nil{}, Nil{}, Nil{}, Nil{}, Nil{}, Nil{}, Nil{}, Nil{}}

def Repeats.apply.packed_ints(v: Pb.Value, m: Repeats) -> Result<&2, &1, String, Repeats>:
  match m:
    case Repeats{f_packed_ints, f_unpacked_ints, f_names, f_blobs, f_longs, f_doubles, f_flags, f_colors, f_items}:
      do Result<&2, &1, String, Repeats>:
        r : List<&2, U32> <- Pbr.read.repeated.int32(v, f_packed_ints)
        return Repeats{r, f_unpacked_ints, f_names, f_blobs, f_longs, f_doubles, f_flags, f_colors, f_items}

def Repeats.apply.unpacked_ints(v: Pb.Value, m: Repeats) -> Result<&2, &1, String, Repeats>:
