def Optionals.j.maybe_int(x: Maybe<&2, U32>, acc: List<&1, Bytes.Bytes & Json.Val>) -> List<&1, Bytes.Bytes & Json.Val>:
  match x:
    case None{}:
      acc
    case Some{s}:
      Pj.put.int32.always("maybeInt", s, acc)

def Optionals.j.maybe_string(x: Maybe<&2, String>, acc: List<&1, Bytes.Bytes & Json.Val>) -> List<&1, Bytes.Bytes & Json.Val>:
  match x:
    case None{}:
      acc
    case Some{s}:
      Pj.put.string.always("maybeString", s, acc)

