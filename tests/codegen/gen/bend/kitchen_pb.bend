  match t:
    case Tuple{v, rest}:
      do Result<&2, &1, String, List<&1, String & Json.Val> & Kitchen>:
        r : Maybe<&2, Scalars> <- Pj.read.opt(~Scalars, ~Scalars.from_json, v)
        return (rest, Kitchen.set.scalars(r, m))

