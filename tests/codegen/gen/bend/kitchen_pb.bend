        r : List<&2, U32> <- Pbr.read.repeated.enum(v, f_colors)
        return Repeats{f_packed_ints, f_unpacked_ints, f_names, f_blobs, f_longs, f_doubles, f_flags, r, f_items}

def Repeats.attach.items(sub: Scalars, m: Repeats) -> Repeats:
  match m:
    case Repeats{f_packed_ints, f_unpacked_ints, f_names, f_blobs, f_longs, f_doubles, f_flags, f_colors, f_items}:
      Repeats{f_packed_ints, f_unpacked_ints, f_names, f_blobs, f_longs, f_doubles, f_flags, f_colors, Con{sub, f_items}}

def Repeats.finish(m: Repeats) -> Repeats:
  match m:
    case Repeats{f_packed_ints, f_unpacked_ints, f_names, f_blobs, f_longs, f_doubles, f_flags, f_colors, f_items}:
      Repeats{Pbr.rev(U32, f_packed_ints), Pbr.rev(U32, f_unpacked_ints), Pbr.rev(String, f_names), Pbr.rev(List<&2, U32>, f_blobs), Pbr.rev(Pb.Word64, f_longs), Pbr.rev(F32, f_doubles), Pbr.rev(Bool, f_flags), Pbr.rev(U32, f_colors), Pbr.rev(Scalars, f_items)}

def Repeats.dec(+fuel: Nat, fields: List<&1, Pb.Field>, acc: Repeats) -> Result<&2, &1, String, Repeats>:
  match fuel:
    case 0n:
      Fail{"message nesting too deep"}
    case 1n+p:
      match fields:
        case Nil{}:
          Done{Repeats.finish(acc)}
        case Con{Pb.Field{n, v}, rest}:
          match n:
            case 1:
              do Result<&2, &1, String, Repeats>:
                acc2 : Repeats <- Repeats.apply.packed_ints(v, acc)
                Repeats.dec(fuel, rest, acc2)
            case 2:
              do Result<&2, &1, String, Repeats>:
                acc2 : Repeats <- Repeats.apply.unpacked_ints(v, acc)
                Repeats.dec(fuel, rest, acc2)
            case 3:
              do Result<&2, &1, String, Repeats>:
                acc2 : Repeats <- Repeats.apply.names(v, acc)
                Repeats.dec(fuel, rest, acc2)
            case 4:
              do Result<&2, &1, String, Repeats>:
                acc2 : Repeats <- Repeats.apply.blobs(v, acc)
                Repeats.dec(fuel, rest, acc2)
            case 5:
              do Result<&2, &1, String, Repeats>:
                acc2 : Repeats <- Repeats.apply.longs(v, acc)
                Repeats.dec(fuel, rest, acc2)
            case 6:
              do Result<&2, &1, String, Repeats>:
                acc2 : Repeats <- Repeats.apply.doubles(v, acc)
                Repeats.dec(fuel, rest, acc2)
            case 7:
              do Result<&2, &1, String, Repeats>:
                acc2 : Repeats <- Repeats.apply.flags(v, acc)
                Repeats.dec(fuel, rest, acc2)
            case 8:
              do Result<&2, &1, String, Repeats>:
                acc2 : Repeats <- Repeats.apply.colors(v, acc)
                Repeats.dec(fuel, rest, acc2)
            case 9:
              do Result<&2, &1, String, Repeats>:
                fs : List<&1, Pb.Field> <- Pbr.read.message(v)
                sub : Scalars <- Scalars.dec(p, fs, Scalars.default())
                Repeats.dec(fuel, rest, Repeats.attach.items(sub, acc))
            case _:
              Repeats.dec(fuel, rest, acc)

def Repeats.decode_proto(b: Bytes.Bytes) -> Result<&2, &1, String, Repeats>:
  do Result<&2, &1, String, Repeats>:
    fs : List<&1, Pb.Field> <- Pbr.decode(b)
    Repeats.dec(100n, fs, Repeats.default())

def Repeats.f.items.items(xs: List<&2, Scalars>) -> List<&1, List<&1, Pb.Field>>:
  match xs:
    case Nil{}:
      Nil{}
    case Con{h, t}:
      Con{Scalars.fields(h), Repeats.f.items.items(t)}

def Repeats.f.items(xs: List<&2, Scalars>) -> List<&1, Pb.Field>:
  Pbr.field.repeated.message(9, Repeats.f.items.items(xs))

def Repeats.fields(m: Repeats) -> List<&1, Pb.Field>:
  match m:
    case Repeats{f_packed_ints, f_unpacked_ints, f_names, f_blobs, f_longs, f_doubles, f_flags, f_colors, f_items}:
      Pbr.cat.all([Pbr.field.repeated.int32(1, f_packed_ints), Pbr.rep.each(~U32, ~Pbr.value.int32, 2, f_unpacked_ints), Pbr.field.repeated.string(3, f_names), Pbr.field.repeated.bytes(4, f_blobs), Pbr.field.repeated.int64(5, f_longs), Pbr.field.repeated.double(6, f_doubles), Pbr.field.repeated.bool(7, f_flags), Pbr.field.repeated.enum(8, f_colors), Repeats.f.items(f_items)])

def Repeats.encode_proto(m: Repeats) -> Bytes.Bytes:
  Pbr.encode(Repeats.fields(m))

