def Keywords.jf.data(st: List<&1, String & Json.Val> & Keywords) -> Result<&2, &1, String, List<&1, String & Json.Val> & Keywords>:
  match st:
    case Tuple{kvs, m}:
      Keywords.jf.data.k(Pj.take(kvs, "data", "data"), m)

def Keywords.jf.kind.k(t: Json.Val & List<&1, String & Json.Val>, m: Keywords) -> Result<&2, &1, String, List<&1, String & Json.Val> & Keywords>:
  match t:
    case Tuple{v, rest}:
      do Result<&2, &1, String, List<&1, String & Json.Val> & Keywords>:
        r : U32 <- Color.read_json(v)
        return (rest, Keywords.set.kind(r, m))

def Keywords.jf.kind(st: List<&1, String & Json.Val> & Keywords) -> Result<&2, &1, String, List<&1, String & Json.Val> & Keywords>:
  match st:
    case Tuple{kvs, m}:
      Keywords.jf.kind.k(Pj.take(kvs, "kind", "kind"), m)

def Keywords.jf.finish(st: List<&1, String & Json.Val> & Keywords) -> Keywords:
  match st:
    case Tuple{kvs, m}:
      m

def Keywords.from_json(v: Json.Val) -> Result<&2, &1, String, Keywords>:
  do Result<&2, &1, String, Keywords>:
    kvs : List<&1, String & Json.Val> <- Pj.fields(v)
    s1 : List<&1, String & Json.Val> & Keywords <- Keywords.jf.type_((kvs, Keywords.default()))
    s2 : List<&1, String & Json.Val> & Keywords <- Keywords.jf.match_(s1)
    s3 : List<&1, String & Json.Val> & Keywords <- Keywords.jf.def_(s2)
    s4 : List<&1, String & Json.Val> & Keywords <- Keywords.jf.import_(s3)
    s5 : List<&1, String & Json.Val> & Keywords <- Keywords.jf.for_(s4)
    s6 : List<&1, String & Json.Val> & Keywords <- Keywords.jf.data(s5)
    s7 : List<&1, String & Json.Val> & Keywords <- Keywords.jf.kind(s6)
    return Keywords.jf.finish(s7)

def Keywords.encode_json(m: Keywords) -> Bytes.Bytes:
  Pj.encode(Keywords.to_json(m))

def Keywords.decode_json(b: Bytes.Bytes) -> Result<&2, &1, String, Keywords>:
  do Result<&2, &1, String, Keywords>:
    v : Json.Val <- Pj.parse(b)
    Keywords.from_json(v)

def Keywords.encode(+codec: P.Codec, m: Keywords) -> Bytes.Bytes:
  match codec:
    case P.Json{}:
      Keywords.encode_json(m)
    case P.Proto{}:
      Keywords.encode_proto(m)
    case P.Custom{name}:
      Bytes.new(0)

def Keywords.decode(+codec: P.Codec, b: Bytes.Bytes) -> Result<&1, &1, E.Error, Keywords>:
  match codec:
    case P.Json{}:
      lift_error(Keywords, Keywords.decode_json(b))
    case P.Proto{}:
      lift_error(Keywords, Keywords.decode_proto(b))
    case P.Custom{name}:
      Fail{E.new(Code.Unimplemented{}, "codec not supported: " ++ name)}

# ---------------------------------------------------------------- message Kitchen

def Kitchen.default() -> Kitchen:
  Kitchen{None{}, None{}, None{}, None{}, None{}, None{}, None{}, None{}}

def Kitchen.attach.scalars(sub: Scalars, m: Kitchen) -> Kitchen:
  match m:
    case Kitchen{_, f_repeats, f_outer, f_tree, f_maps, f_choice, f_optionals, f_keywords}:
      Kitchen{Some{sub}, f_repeats, f_outer, f_tree, f_maps, f_choice, f_optionals, f_keywords}

def Kitchen.attach.repeats(sub: Repeats, m: Kitchen) -> Kitchen:
  match m:
    case Kitchen{f_scalars, _, f_outer, f_tree, f_maps, f_choice, f_optionals, f_keywords}:
      Kitchen{f_scalars, Some{sub}, f_outer, f_tree, f_maps, f_choice, f_optionals, f_keywords}

def Kitchen.attach.outer(sub: Outer, m: Kitchen) -> Kitchen:
  match m:
    case Kitchen{f_scalars, f_repeats, _, f_tree, f_maps, f_choice, f_optionals, f_keywords}:
      Kitchen{f_scalars, f_repeats, Some{sub}, f_tree, f_maps, f_choice, f_optionals, f_keywords}

def Kitchen.attach.tree(sub: Tree, m: Kitchen) -> Kitchen:
  match m:
    case Kitchen{f_scalars, f_repeats, f_outer, _, f_maps, f_choice, f_optionals, f_keywords}:
      Kitchen{f_scalars, f_repeats, f_outer, Some{sub}, f_maps, f_choice, f_optionals, f_keywords}

def Kitchen.attach.maps(sub: Maps, m: Kitchen) -> Kitchen:
  match m:
    case Kitchen{f_scalars, f_repeats, f_outer, f_tree, _, f_choice, f_optionals, f_keywords}:
      Kitchen{f_scalars, f_repeats, f_outer, f_tree, Some{sub}, f_choice, f_optionals, f_keywords}

def Kitchen.attach.choice(sub: Choice, m: Kitchen) -> Kitchen:
  match m:
    case Kitchen{f_scalars, f_repeats, f_outer, f_tree, f_maps, _, f_optionals, f_keywords}:
      Kitchen{f_scalars, f_repeats, f_outer, f_tree, f_maps, Some{sub}, f_optionals, f_keywords}

def Kitchen.attach.optionals(sub: Optionals, m: Kitchen) -> Kitchen:
  match m:
    case Kitchen{f_scalars, f_repeats, f_outer, f_tree, f_maps, f_choice, _, f_keywords}:
      Kitchen{f_scalars, f_repeats, f_outer, f_tree, f_maps, f_choice, Some{sub}, f_keywords}

def Kitchen.attach.keywords(sub: Keywords, m: Kitchen) -> Kitchen:
  match m:
    case Kitchen{f_scalars, f_repeats, f_outer, f_tree, f_maps, f_choice, f_optionals, _}:
      Kitchen{f_scalars, f_repeats, f_outer, f_tree, f_maps, f_choice, f_optionals, Some{sub}}

def Kitchen.dec(+fuel: Nat, fields: List<&1, Pb.Field>, acc: Kitchen) -> Result<&2, &1, String, Kitchen>:
  match fuel:
    case 0n:
      Fail{"message nesting too deep"}
    case 1n+p:
      match fields:
        case Nil{}:
          Done{acc}
        case Con{Pb.Field{n, v}, rest}:
          match n:
            case 1:
              do Result<&2, &1, String, Kitchen>:
                fs : List<&1, Pb.Field> <- Pbr.read.message(v)
                sub : Scalars <- Scalars.dec(p, fs, Scalars.default())
                Kitchen.dec(fuel, rest, Kitchen.attach.scalars(sub, acc))
            case 2:
              do Result<&2, &1, String, Kitchen>:
                fs : List<&1, Pb.Field> <- Pbr.read.message(v)
                sub : Repeats <- Repeats.dec(p, fs, Repeats.default())
                Kitchen.dec(fuel, rest, Kitchen.attach.repeats(sub, acc))
            case 3:
              do Result<&2, &1, String, Kitchen>:
                fs : List<&1, Pb.Field> <- Pbr.read.message(v)
                sub : Outer <- Outer.dec(p, fs, Outer.default())
                Kitchen.dec(fuel, rest, Kitchen.attach.outer(sub, acc))
            case 4:
              do Result<&2, &1, String, Kitchen>:
                fs : List<&1, Pb.Field> <- Pbr.read.message(v)
                sub : Tree <- Tree.dec(p, fs, Tree.default())
                Kitchen.dec(fuel, rest, Kitchen.attach.tree(sub, acc))
            case 5:
              do Result<&2, &1, String, Kitchen>:
                fs : List<&1, Pb.Field> <- Pbr.read.message(v)
                sub : Maps <- Maps.dec(p, fs, Maps.default())
                Kitchen.dec(fuel, rest, Kitchen.attach.maps(sub, acc))
            case 6:
              do Result<&2, &1, String, Kitchen>:
                fs : List<&1, Pb.Field> <- Pbr.read.message(v)
                sub : Choice <- Choice.dec(p, fs, Choice.default())
                Kitchen.dec(fuel, rest, Kitchen.attach.choice(sub, acc))
            case 7:
              do Result<&2, &1, String, Kitchen>:
                fs : List<&1, Pb.Field> <- Pbr.read.message(v)
                sub : Optionals <- Optionals.dec(p, fs, Optionals.default())
                Kitchen.dec(fuel, rest, Kitchen.attach.optionals(sub, acc))
            case 8:
              do Result<&2, &1, String, Kitchen>:
                fs : List<&1, Pb.Field> <- Pbr.read.message(v)
                sub : Keywords <- Keywords.dec(p, fs, Keywords.default())
                Kitchen.dec(fuel, rest, Kitchen.attach.keywords(sub, acc))
            case _:
              Kitchen.dec(fuel, rest, acc)

def Kitchen.decode_proto(b: Bytes.Bytes) -> Result<&2, &1, String, Kitchen>:
  do Result<&2, &1, String, Kitchen>:
    fs : List<&1, Pb.Field> <- Pbr.decode(b)
    Kitchen.dec(100n, fs, Kitchen.default())

