def Kitchen.jf.finish(st: List<&1, String & Json.Val> & Kitchen) -> Kitchen:
  match st:
    case Tuple{kvs, m}:
      m

def Kitchen.from_json(v: Json.Val) -> Result<&2, &1, String, Kitchen>:
  do Result<&2, &1, String, Kitchen>:
    kvs : List<&1, String & Json.Val> <- Pj.fields(v)
    s1 : List<&1, String & Json.Val> & Kitchen <- Kitchen.jf.scalars((kvs, Kitchen.default()))
    s2 : List<&1, String & Json.Val> & Kitchen <- Kitchen.jf.repeats(s1)
    s3 : List<&1, String & Json.Val> & Kitchen <- Kitchen.jf.outer(s2)
    s4 : List<&1, String & Json.Val> & Kitchen <- Kitchen.jf.tree(s3)
    s5 : List<&1, String & Json.Val> & Kitchen <- Kitchen.jf.maps(s4)
    s6 : List<&1, String & Json.Val> & Kitchen <- Kitchen.jf.choice(s5)
    s7 : List<&1, String & Json.Val> & Kitchen <- Kitchen.jf.optionals(s6)
    s8 : List<&1, String & Json.Val> & Kitchen <- Kitchen.jf.keywords(s7)
    return Kitchen.jf.finish(s8)

def Kitchen.encode_json(m: Kitchen) -> Bytes.Bytes:
  Pj.encode(Kitchen.to_json(m))

def Kitchen.decode_json(b: Bytes.Bytes) -> Result<&2, &1, String, Kitchen>:
  do Result<&2, &1, String, Kitchen>:
    v : Json.Val <- Pj.parse(b)
    Kitchen.from_json(v)

def Kitchen.encode(+codec: P.Codec, m: Kitchen) -> Bytes.Bytes:
  match codec:
    case P.Json{}:
      Kitchen.encode_json(m)
    case P.Proto{}:
      Kitchen.encode_proto(m)
    case P.Custom{name}:
      Bytes.new(0)

def Kitchen.decode(+codec: P.Codec, b: Bytes.Bytes) -> Result<&1, &1, E.Error, Kitchen>:
  match codec:
    case P.Json{}:
      lift_error(Kitchen, Kitchen.decode_json(b))
    case P.Proto{}:
      lift_error(Kitchen, Kitchen.decode_proto(b))
    case P.Custom{name}:
      Fail{E.new(Code.Unimplemented{}, "codec not supported: " ++ name)}
