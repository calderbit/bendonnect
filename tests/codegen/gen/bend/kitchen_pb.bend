def Optionals.jf.finish(st: List<&1, String & Json.Val> & Optionals) -> Optionals:
  match st:
    case Tuple{kvs, m}:
      m

def Optionals.from_json(v: Json.Val) -> Result<&2, &1, String, Optionals>:
  do Result<&2, &1, String, Optionals>:
    kvs : List<&1, String & Json.Val> <- Pj.fields(v)
    s1 : List<&1, String & Json.Val> & Optionals <- Optionals.jf.maybe_int((kvs, Optionals.default()))
    s2 : List<&1, String & Json.Val> & Optionals <- Optionals.jf.maybe_string(s1)
    s3 : List<&1, String & Json.Val> & Optionals <- Optionals.jf.maybe_bool(s2)
    s4 : List<&1, String & Json.Val> & Optionals <- Optionals.jf.maybe_color(s3)
    s5 : List<&1, String & Json.Val> & Optionals <- Optionals.jf.maybe_long(s4)
    s6 : List<&1, String & Json.Val> & Optionals <- Optionals.jf.plain(s5)
    s7 : List<&1, String & Json.Val> & Optionals <- Optionals.jf.maybe_msg(s6)
    s8 : List<&1, String & Json.Val> & Optionals <- Optionals.jf.maybe_bytes(s7)
    s9 : List<&1, String & Json.Val> & Optionals <- Optionals.jf.maybe_double(s8)
    return Optionals.jf.finish(s9)

def Optionals.encode_json(m: Optionals) -> Bytes.Bytes:
  Pj.encode(Optionals.to_json(m))

def Optionals.decode_json(b: Bytes.Bytes) -> Result<&2, &1, String, Optionals>:
  do Result<&2, &1, String, Optionals>:
    v : Json.Val <- Pj.parse(b)
    Optionals.from_json(v)

def Optionals.encode(+codec: P.Codec, m: Optionals) -> Bytes.Bytes:
  match codec:
    case P.Json{}:
      Optionals.encode_json(m)
    case P.Proto{}:
      Optionals.encode_proto(m)
    case P.Custom{name}:
      Bytes.new(0)

def Optionals.decode(+codec: P.Codec, b: Bytes.Bytes) -> Result<&1, &1, E.Error, Optionals>:
  match codec:
    case P.Json{}:
      lift_error(Optionals, Optionals.decode_json(b))
    case P.Proto{}:
      lift_error(Optionals, Optionals.decode_proto(b))
    case P.Custom{name}:
      Fail{E.new(Code.Unimplemented{}, "codec not supported: " ++ name)}

# ---------------------------------------------------------------- message Keywords

def Keywords.default() -> Keywords:
  Keywords{"", 0, False{}, "", 0, "", 0}

def Keywords.apply.type_(v: Pb.Value, m: Keywords) -> Result<&2, &1, String, Keywords>:
  match m:
    case Keywords{_, f_match, f_def, f_import, f_for, f_data, f_kind}:
      do Result<&2, &1, String, Keywords>:
        r : String <- Pbr.read.string(v)
        return Keywords{r, f_match, f_def, f_import, f_for, f_data, f_kind}

def Keywords.apply.match_(v: Pb.Value, m: Keywords) -> Result<&2, &1, String, Keywords>:
  match m:
    case Keywords{f_type, _, f_def, f_import, f_for, f_data, f_kind}:
      do Result<&2, &1, String, Keywords>:
        r : U32 <- Pbr.read.int32(v)
        return Keywords{f_type, r, f_def, f_import, f_for, f_data, f_kind}

def Keywords.apply.def_(v: Pb.Value, m: Keywords) -> Result<&2, &1, String, Keywords>:
  match m:
    case Keywords{f_type, f_match, _, f_import, f_for, f_data, f_kind}:
      do Result<&2, &1, String, Keywords>:
        r : Bool <- Pbr.read.bool(v)
        return Keywords{f_type, f_match, r, f_import, f_for, f_data, f_kind}

def Keywords.apply.import_(v: Pb.Value, m: Keywords) -> Result<&2, &1, String, Keywords>:
  match m:
    case Keywords{f_type, f_match, f_def, _, f_for, f_data, f_kind}:
      do Result<&2, &1, String, Keywords>:
        r : String <- Pbr.read.string(v)
        return Keywords{f_type, f_match, f_def, r, f_for, f_data, f_kind}

def Keywords.apply.for_(v: Pb.Value, m: Keywords) -> Result<&2, &1, String, Keywords>:
  match m:
    case Keywords{f_type, f_match, f_def, f_import, _, f_data, f_kind}:
      do Result<&2, &1, String, Keywords>:
        r : U32 <- Pbr.read.uint32(v)
        return Keywords{f_type, f_match, f_def, f_import, r, f_data, f_kind}

def Keywords.apply.data(v: Pb.Value, m: Keywords) -> Result<&2, &1, String, Keywords>:
  match m:
    case Keywords{f_type, f_match, f_def, f_import, f_for, _, f_kind}:
      do Result<&2, &1, String, Keywords>:
        r : String <- Pbr.read.string(v)
        return Keywords{f_type, f_match, f_def, f_import, f_for, r, f_kind}

def Keywords.apply.kind(v: Pb.Value, m: Keywords) -> Result<&2, &1, String, Keywords>:
  match m:
    case Keywords{f_type, f_match, f_def, f_import, f_for, f_data, _}:
      do Result<&2, &1, String, Keywords>:
        r : U32 <- Pbr.read.enum(v)
        return Keywords{f_type, f_match, f_def, f_import, f_for, f_data, r}

def Keywords.dec(+fuel: Nat, fields: List<&1, Pb.Field>, acc: Keywords) -> Result<&2, &1, String, Keywords>:
  match fuel:
    case 0n:
      Fail{"message nesting too deep"}
    case 1n+p:
      match fields:
        case Nil{}:
          Done{acc}
        case Con{Pb.Field{n, v}, rest}:
          match n:
            case 1:
              do Result<&2, &1, String, Keywords>:
                acc2 : Keywords <- Keywords.apply.type_(v, acc)
                Keywords.dec(fuel, rest, acc2)
            case 2:
              do Result<&2, &1, String, Keywords>:
                acc2 : Keywords <- Keywords.apply.match_(v, acc)
                Keywords.dec(fuel, rest, acc2)
            case 3:
              do Result<&2, &1, String, Keywords>:
                acc2 : Keywords <- Keywords.apply.def_(v, acc)
                Keywords.dec(fuel, rest, acc2)
            case 4:
              do Result<&2, &1, String, Keywords>:
                acc2 : Keywords <- Keywords.apply.import_(v, acc)
                Keywords.dec(fuel, rest, acc2)
            case 5:
              do Result<&2, &1, String, Keywords>:
                acc2 : Keywords <- Keywords.apply.for_(v, acc)
                Keywords.dec(fuel, rest, acc2)
            case 6:
              do Result<&2, &1, String, Keywords>:
                acc2 : Keywords <- Keywords.apply.data(v, acc)
                Keywords.dec(fuel, rest, acc2)
            case 7:
              do Result<&2, &1, String, Keywords>:
                acc2 : Keywords <- Keywords.apply.kind(v, acc)
                Keywords.dec(fuel, rest, acc2)
            case _:
              Keywords.dec(fuel, rest, acc)

def Keywords.decode_proto(b: Bytes.Bytes) -> Result<&2, &1, String, Keywords>:
  do Result<&2, &1, String, Keywords>:
    fs : List<&1, Pb.Field> <- Pbr.decode(b)
    Keywords.dec(100n, fs, Keywords.default())

def Keywords.fields(m: Keywords) -> List<&1, Pb.Field>:
  match m:
    case Keywords{f_type, f_match, f_def, f_import, f_for, f_data, f_kind}:
      Pbr.cat.all([Pbr.field.string(1, f_type), Pbr.field.int32(2, f_match), Pbr.field.bool(3, f_def), Pbr.field.string(4, f_import), Pbr.field.uint32(5, f_for), Pbr.field.string(6, f_data), Pbr.field.enum(7, f_kind)])

def Keywords.encode_proto(m: Keywords) -> Bytes.Bytes:
  Pbr.encode(Keywords.fields(m))

def Keywords.set.type_(x: String, m: Keywords) -> Keywords:
  match m:
    case Keywords{_, f_match, f_def, f_import, f_for, f_data, f_kind}:
      Keywords{x, f_match, f_def, f_import, f_for, f_data, f_kind}

def Keywords.set.match_(x: U32, m: Keywords) -> Keywords:
  match m:
    case Keywords{f_type, _, f_def, f_import, f_for, f_data, f_kind}:
      Keywords{f_type, x, f_def, f_import, f_for, f_data, f_kind}

def Keywords.set.def_(x: Bool, m: Keywords) -> Keywords:
  match m:
    case Keywords{f_type, f_match, _, f_import, f_for, f_data, f_kind}:
      Keywords{f_type, f_match, x, f_import, f_for, f_data, f_kind}

