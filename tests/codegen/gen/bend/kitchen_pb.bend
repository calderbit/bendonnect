def Keywords.set.data(x: String, m: Keywords) -> Keywords:
  match m:
    case Keywords{f_type, f_match, f_def, f_import, f_for, _, f_kind}:
      Keywords{f_type, f_match, f_def, f_import, f_for, x, f_kind}

def Keywords.set.kind(x: U32, m: Keywords) -> Keywords:
  match m:
    case Keywords{f_type, f_match, f_def, f_import, f_for, f_data, _}:
      Keywords{f_type, f_match, f_def, f_import, f_for, f_data, x}

def Keywords.to_json(m: Keywords) -> Json.Val:
  match m:
    case Keywords{f_type, f_match, f_def, f_import, f_for, f_data, f_kind}:
      Pj.obj(Pj.put.enum(~Color.name, "kind", f_kind, Pj.put.string("data", f_data, Pj.put.uint32("for", f_for, Pj.put.string("import", f_import, Pj.put.bool("def", f_def, Pj.put.int32("match", f_match, Pj.put.string("type", f_type, Nil{}))))))))

def Keywords.jf.type_.k(t: Json.Val & List<&1, String & Json.Val>, m: Keywords) -> Result<&2, &1, String, List<&1, String & Json.Val> & Keywords>:
  match t:
    case Tuple{v, rest}:
      do Result<&2, &1, String, List<&1, String & Json.Val> & Keywords>:
        r : String <- Pj.read.string(v)
        return (rest, Keywords.set.type_(r, m))

