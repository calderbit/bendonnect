def Maps.default() -> Maps:
  Maps{Nil{}, Nil{}, Nil{}, Nil{}, Nil{}, Nil{}}

def Maps.attach.counts(sub: Maps.CountsEntry, m: Maps) -> Maps:
  match m:
    case Maps{f_counts, f_by_id, f_labels, f_flags, f_blobs, f_colors}:
      Maps{Con{sub, f_counts}, f_by_id, f_labels, f_flags, f_blobs, f_colors}

def Maps.attach.by_id(sub: Maps.ByIdEntry, m: Maps) -> Maps:
  match m:
    case Maps{f_counts, f_by_id, f_labels, f_flags, f_blobs, f_colors}:
      Maps{f_counts, Con{sub, f_by_id}, f_labels, f_flags, f_blobs, f_colors}

def Maps.attach.labels(sub: Maps.LabelsEntry, m: Maps) -> Maps:
  match m:
    case Maps{f_counts, f_by_id, f_labels, f_flags, f_blobs, f_colors}:
      Maps{f_counts, f_by_id, Con{sub, f_labels}, f_flags, f_blobs, f_colors}

def Maps.attach.flags(sub: Maps.FlagsEntry, m: Maps) -> Maps:
  match m:
    case Maps{f_counts, f_by_id, f_labels, f_flags, f_blobs, f_colors}:
      Maps{f_counts, f_by_id, f_labels, Con{sub, f_flags}, f_blobs, f_colors}

def Maps.attach.blobs(sub: Maps.BlobsEntry, m: Maps) -> Maps:
  match m:
    case Maps{f_counts, f_by_id, f_labels, f_flags, f_blobs, f_colors}:
      Maps{f_counts, f_by_id, f_labels, f_flags, Con{sub, f_blobs}, f_colors}

def Maps.attach.colors(sub: Maps.ColorsEntry, m: Maps) -> Maps:
  match m:
    case Maps{f_counts, f_by_id, f_labels, f_flags, f_blobs, f_colors}:
      Maps{f_counts, f_by_id, f_labels, f_flags, f_blobs, Con{sub, f_colors}}

def Maps.finish(m: Maps) -> Maps:
  match m:
    case Maps{f_counts, f_by_id, f_labels, f_flags, f_blobs, f_colors}:
      Maps{Pbr.rev(Maps.CountsEntry, f_counts), Pbr.rev(Maps.ByIdEntry, f_by_id), Pbr.rev(Maps.LabelsEntry, f_labels), Pbr.rev(Maps.FlagsEntry, f_flags), Pbr.rev(Maps.BlobsEntry, f_blobs), Pbr.rev(Maps.ColorsEntry, f_colors)}

def Maps.dec(+fuel: Nat, fields: List<&1, Pb.Field>, acc: Maps) -> Result<&2, &1, String, Maps>:
  match fuel:
    case 0n:
      Fail{"message nesting too deep"}
    case 1n+p:
      match fields:
        case Nil{}:
          Done{Maps.finish(acc)}
        case Con{Pb.Field{n, v}, rest}:
          match n:
            case 1:
              do Result<&2, &1, String, Maps>:
                fs : List<&1, Pb.Field> <- Pbr.read.message(v)
                sub : Maps.CountsEntry <- Maps.CountsEntry.dec(p, fs, Maps.CountsEntry.default())
                Maps.dec(fuel, rest, Maps.attach.counts(sub, acc))
            case 2:
              do Result<&2, &1, String, Maps>:
                fs : List<&1, Pb.Field> <- Pbr.read.message(v)
                sub : Maps.ByIdEntry <- Maps.ByIdEntry.dec(p, fs, Maps.ByIdEntry.default())
                Maps.dec(fuel, rest, Maps.attach.by_id(sub, acc))
            case 3:
              do Result<&2, &1, String, Maps>:
                fs : List<&1, Pb.Field> <- Pbr.read.message(v)
                sub : Maps.LabelsEntry <- Maps.LabelsEntry.dec(p, fs, Maps.LabelsEntry.default())
                Maps.dec(fuel, rest, Maps.attach.labels(sub, acc))
            case 4:
              do Result<&2, &1, String, Maps>:
                fs : List<&1, Pb.Field> <- Pbr.read.message(v)
                sub : Maps.FlagsEntry <- Maps.FlagsEntry.dec(p, fs, Maps.FlagsEntry.default())
                Maps.dec(fuel, rest, Maps.attach.flags(sub, acc))
            case 5:
              do Result<&2, &1, String, Maps>:
                fs : List<&1, Pb.Field> <- Pbr.read.message(v)
                sub : Maps.BlobsEntry <- Maps.BlobsEntry.dec(p, fs, Maps.BlobsEntry.default())
                Maps.dec(fuel, rest, Maps.attach.blobs(sub, acc))
            case 6:
              do Result<&2, &1, String, Maps>:
                fs : List<&1, Pb.Field> <- Pbr.read.message(v)
                sub : Maps.ColorsEntry <- Maps.ColorsEntry.dec(p, fs, Maps.ColorsEntry.default())
                Maps.dec(fuel, rest, Maps.attach.colors(sub, acc))
            case _:
              Maps.dec(fuel, rest, acc)

def Maps.decode_proto(b: Bytes.Bytes) -> Result<&2, &1, String, Maps>:
  do Result<&2, &1, String, Maps>:
    fs : List<&1, Pb.Field> <- Pbr.decode(b)
    Maps.dec(100n, fs, Maps.default())

def Maps.f.counts.items(xs: List<&2, Maps.CountsEntry>) -> List<&1, List<&1, Pb.Field>>:
  match xs:
    case Nil{}:
      Nil{}
    case Con{h, t}:
      Con{Maps.CountsEntry.fields(h), Maps.f.counts.items(t)}

def Maps.f.counts(xs: List<&2, Maps.CountsEntry>) -> List<&1, Pb.Field>:
  Pbr.field.repeated.message(1, Maps.f.counts.items(xs))

def Maps.f.by_id.items(xs: List<&2, Maps.ByIdEntry>) -> List<&1, List<&1, Pb.Field>>:
  match xs:
    case Nil{}:
