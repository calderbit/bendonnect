def Kitchen.fields(m: Kitchen) -> List<&1, Pb.Field>:
  match m:
    case Kitchen{f_scalars, f_repeats, f_outer, f_tree, f_maps, f_choice, f_optionals, f_keywords}:
      Pbr.cat.all([Kitchen.f.scalars(f_scalars), Kitchen.f.repeats(f_repeats), Kitchen.f.outer(f_outer), Kitchen.f.tree(f_tree), Kitchen.f.maps(f_maps), Kitchen.f.choice(f_choice), Kitchen.f.optionals(f_optionals), Kitchen.f.keywords(f_keywords)])

def Kitchen.encode_proto(m: Kitchen) -> Bytes.Bytes:
