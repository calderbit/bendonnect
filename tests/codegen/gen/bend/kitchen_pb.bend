            case 2:
              do Result<&2, &1, String, Maps.ByIdEntry>:
                fs : List<&1, Pb.Field> <- Pbr.read.message(v)
                sub : Scalars <- Scalars.dec(p, fs, Scalars.default())
                Maps.ByIdEntry.dec(fuel, rest, Maps.ByIdEntry.attach.value(sub, acc))
