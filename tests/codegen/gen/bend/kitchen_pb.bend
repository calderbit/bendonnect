    case Tuple{kvs, m}:
      Maps.jf.colors.k(Pj.take(kvs, "colors", "colors"), m)

def Maps.jf.finish(st: List<&1, String & Json.Val> & Maps) -> Maps:
  match st:
    case Tuple{kvs, m}:
      m

def Maps.from_json(v: Json.Val) -> Result<&2, &1, String, Maps>:
  do Result<&2, &1, String, Maps>:
    kvs : List<&1, String & Json.Val> <- Pj.fields(v)
    s1 : List<&1, String & Json.Val> & Maps <- Maps.jf.counts((kvs, Maps.default()))
    s2 : List<&1, String & Json.Val> & Maps <- Maps.jf.by_id(s1)
    s3 : List<&1, String & Json.Val> & Maps <- Maps.jf.labels(s2)
    s4 : List<&1, String & Json.Val> & Maps <- Maps.jf.flags(s3)
    s5 : List<&1, String & Json.Val> & Maps <- Maps.jf.blobs(s4)
    s6 : List<&1, String & Json.Val> & Maps <- Maps.jf.colors(s5)
    return Maps.jf.finish(s6)

def Maps.encode_json(m: Maps) -> Bytes.Bytes:
  Pj.encode(Maps.to_json(m))

def Maps.decode_json(b: Bytes.Bytes) -> Result<&2, &1, String, Maps>:
  do Result<&2, &1, String, Maps>:
    v : Json.Val <- Pj.parse(b)
    Maps.from_json(v)

def Maps.encode(+codec: P.Codec, m: Maps) -> Bytes.Bytes:
  match codec:
    case P.Json{}:
      Maps.encode_json(m)
    case P.Proto{}:
      Maps.encode_proto(m)
    case P.Custom{name}:
      Bytes.new(0)

def Maps.decode(+codec: P.Codec, b: Bytes.Bytes) -> Result<&1, &1, E.Error, Maps>:
  match codec:
    case P.Json{}:
      lift_error(Maps, Maps.decode_json(b))
    case P.Proto{}:
      lift_error(Maps, Maps.decode_proto(b))
    case P.Custom{name}:
      Fail{E.new(Code.Unimplemented{}, "codec not supported: " ++ name)}

# ---------------------------------------------------------------- message Choice

def Choice.default() -> Choice:
  Choice{"", Choice.Value.None{}}

def Choice.apply.tag(v: Pb.Value, m: Choice) -> Result<&2, &1, String, Choice>:
  match m:
    case Choice{_, f_value}:
      do Result<&2, &1, String, Choice>:
        r : String <- Pbr.read.string(v)
        return Choice{r, f_value}

def Choice.apply.number(v: Pb.Value, m: Choice) -> Result<&2, &1, String, Choice>:
  match m:
    case Choice{f_tag, _}:
      do Result<&2, &1, String, Choice>:
        r : U32 <- Pbr.read.int32(v)
        return Choice{f_tag, Choice.Value.Number{r}}

def Choice.apply.text(v: Pb.Value, m: Choice) -> Result<&2, &1, String, Choice>:
  match m:
    case Choice{f_tag, _}:
      do Result<&2, &1, String, Choice>:
        r : String <- Pbr.read.string(v)
        return Choice{f_tag, Choice.Value.Text{r}}

def Choice.attach.scalars(sub: Scalars, m: Choice) -> Choice:
  match m:
    case Choice{f_tag, _}:
      Choice{f_tag, Choice.Value.Scalars{sub}}

def Choice.apply.color(v: Pb.Value, m: Choice) -> Result<&2, &1, String, Choice>:
  match m:
    case Choice{f_tag, _}:
      do Result<&2, &1, String, Choice>:
        r : U32 <- Pbr.read.enum(v)
        return Choice{f_tag, Choice.Value.Color{r}}

def Choice.apply.raw(v: Pb.Value, m: Choice) -> Result<&2, &1, String, Choice>:
  match m:
    case Choice{f_tag, _}:
      do Result<&2, &1, String, Choice>:
        r : List<&2, U32> <- Pbr.read.bytes(v)
        return Choice{f_tag, Choice.Value.Raw{r}}

def Choice.dec(+fuel: Nat, fields: List<&1, Pb.Field>, acc: Choice) -> Result<&2, &1, String, Choice>:
  match fuel:
    case 0n:
      Fail{"message nesting too deep"}
    case 1n+p:
      match fields:
        case Nil{}:
          Done{acc}
        case Con{Pb.Field{n, v}, rest}:
          match n:
            case 1:
              do Result<&2, &1, String, Choice>:
                acc2 : Choice <- Choice.apply.tag(v, acc)
                Choice.dec(fuel, rest, acc2)
            case 2:
              do Result<&2, &1, String, Choice>:
                acc2 : Choice <- Choice.apply.number(v, acc)
                Choice.dec(fuel, rest, acc2)
            case 3:
              do Result<&2, &1, String, Choice>:
                acc2 : Choice <- Choice.apply.text(v, acc)
                Choice.dec(fuel, rest, acc2)
            case 4:
              do Result<&2, &1, String, Choice>:
                fs : List<&1, Pb.Field> <- Pbr.read.message(v)
                sub : Scalars <- Scalars.dec(p, fs, Scalars.default())
                Choice.dec(fuel, rest, Choice.attach.scalars(sub, acc))
            case 5:
              do Result<&2, &1, String, Choice>:
                acc2 : Choice <- Choice.apply.color(v, acc)
                Choice.dec(fuel, rest, acc2)
            case 6:
              do Result<&2, &1, String, Choice>:
                acc2 : Choice <- Choice.apply.raw(v, acc)
                Choice.dec(fuel, rest, acc2)
            case _:
              Choice.dec(fuel, rest, acc)

def Choice.decode_proto(b: Bytes.Bytes) -> Result<&2, &1, String, Choice>:
  do Result<&2, &1, String, Choice>:
    fs : List<&1, Pb.Field> <- Pbr.decode(b)
    Choice.dec(100n, fs, Choice.default())

def Choice.f.value(o: Choice.Value) -> List<&1, Pb.Field>:
  match o:
    case Choice.Value.None{}:
      Nil{}
    case Choice.Value.Number{s}:
      Pbr.field.int32.always(2, s)
    case Choice.Value.Text{s}:
      Pbr.field.string.always(3, s)
    case Choice.Value.Scalars{s}:
      Pbr.field.message(4, Scalars.fields(s))
    case Choice.Value.Color{s}:
      Pbr.field.enum.always(5, s)
    case Choice.Value.Raw{s}:
      Pbr.field.bytes.always(6, s)

def Choice.fields(m: Choice) -> List<&1, Pb.Field>:
  match m:
    case Choice{f_tag, f_value}:
      Pbr.cat.all([Pbr.field.string(1, f_tag), Choice.f.value(f_value)])

def Choice.encode_proto(m: Choice) -> Bytes.Bytes:
  Pbr.encode(Choice.fields(m))

def Choice.set.tag(x: String, m: Choice) -> Choice:
  match m:
    case Choice{_, f_value}:
      Choice{x, f_value}

def Choice.set.value(x: Choice.Value, m: Choice) -> Choice:
  match m:
    case Choice{f_tag, _}:
      Choice{f_tag, x}

def Choice.set.pick.number(r: Maybe<&2, U32>, m: Choice) -> Choice:
  match r:
    case None{}:
      m
    case Some{x}:
      Choice.set.value(Choice.Value.Number{x}, m)

def Choice.set.pick.text(r: Maybe<&2, String>, m: Choice) -> Choice:
  match r:
    case None{}:
      m
    case Some{x}:
      Choice.set.value(Choice.Value.Text{x}, m)

def Choice.set.pick.scalars(r: Maybe<&2, Scalars>, m: Choice) -> Choice:
  match r:
    case None{}:
      m
    case Some{x}:
      Choice.set.value(Choice.Value.Scalars{x}, m)

def Choice.set.pick.color(r: Maybe<&2, U32>, m: Choice) -> Choice:
  match r:
    case None{}:
      m
    case Some{x}:
      Choice.set.value(Choice.Value.Color{x}, m)

def Choice.set.pick.raw(r: Maybe<&2, List<&2, U32>>, m: Choice) -> Choice:
  match r:
    case None{}:
      m
    case Some{x}:
      Choice.set.value(Choice.Value.Raw{x}, m)

def Choice.j.value(o: Choice.Value, acc: List<&1, Bytes.Bytes & Json.Val>) -> List<&1, Bytes.Bytes & Json.Val>:
  match o:
    case Choice.Value.None{}:
      acc
    case Choice.Value.Number{s}:
      Pj.put.int32.always("number", s, acc)
    case Choice.Value.Text{s}:
      Pj.put.string.always("text", s, acc)
    case Choice.Value.Scalars{s}:
      Pj.put.message("scalars", Scalars.to_json(s), acc)
    case Choice.Value.Color{s}:
      Pj.put.enum.always(~Color.name, "color", s, acc)
    case Choice.Value.Raw{s}:
      Pj.put.bytes.always("raw", s, acc)

def Choice.to_json(m: Choice) -> Json.Val:
  match m:
    case Choice{f_tag, f_value}:
      Pj.obj(Choice.j.value(f_value, Pj.put.string("tag", f_tag, Nil{})))

def Choice.jf.tag.k(t: Json.Val & List<&1, String & Json.Val>, m: Choice) -> Result<&2, &1, String, List<&1, String & Json.Val> & Choice>:
  match t:
    case Tuple{v, rest}:
      do Result<&2, &1, String, List<&1, String & Json.Val> & Choice>:
        r : String <- Pj.read.string(v)
        return (rest, Choice.set.tag(r, m))

def Choice.jf.tag(st: List<&1, String & Json.Val> & Choice) -> Result<&2, &1, String, List<&1, String & Json.Val> & Choice>:
  match st:
    case Tuple{kvs, m}:
      Choice.jf.tag.k(Pj.take(kvs, "tag", "tag"), m)

def Choice.jf.number.k(t: Json.Val & List<&1, String & Json.Val>, m: Choice) -> Result<&2, &1, String, List<&1, String & Json.Val> & Choice>:
  match t:
    case Tuple{v, rest}:
      do Result<&2, &1, String, List<&1, String & Json.Val> & Choice>:
        r : Maybe<&2, U32> <- Pj.read.opt(~U32, ~Pj.read.int32, v)
        return (rest, Choice.set.pick.number(r, m))

def Choice.jf.number(st: List<&1, String & Json.Val> & Choice) -> Result<&2, &1, String, List<&1, String & Json.Val> & Choice>:
  match st:
    case Tuple{kvs, m}:
      Choice.jf.number.k(Pj.take(kvs, "number", "number"), m)

def Choice.jf.text.k(t: Json.Val & List<&1, String & Json.Val>, m: Choice) -> Result<&2, &1, String, List<&1, String & Json.Val> & Choice>:
  match t:
    case Tuple{v, rest}:
      do Result<&2, &1, String, List<&1, String & Json.Val> & Choice>:
        r : Maybe<&2, String> <- Pj.read.opt(~String, ~Pj.read.string, v)
        return (rest, Choice.set.pick.text(r, m))

def Choice.jf.text(st: List<&1, String & Json.Val> & Choice) -> Result<&2, &1, String, List<&1, String & Json.Val> & Choice>:
  match st:
    case Tuple{kvs, m}:
      Choice.jf.text.k(Pj.take(kvs, "text", "text"), m)

def Choice.jf.scalars.k(t: Json.Val & List<&1, String & Json.Val>, m: Choice) -> Result<&2, &1, String, List<&1, String & Json.Val> & Choice>:
  match t:
    case Tuple{v, rest}:
      do Result<&2, &1, String, List<&1, String & Json.Val> & Choice>:
        r : Maybe<&2, Scalars> <- Pj.read.opt(~Scalars, ~Scalars.from_json, v)
        return (rest, Choice.set.pick.scalars(r, m))

def Choice.jf.scalars(st: List<&1, String & Json.Val> & Choice) -> Result<&2, &1, String, List<&1, String & Json.Val> & Choice>:
  match st:
    case Tuple{kvs, m}:
      Choice.jf.scalars.k(Pj.take(kvs, "scalars", "scalars"), m)

def Choice.jf.color.k(t: Json.Val & List<&1, String & Json.Val>, m: Choice) -> Result<&2, &1, String, List<&1, String & Json.Val> & Choice>:
  match t:
    case Tuple{v, rest}:
      do Result<&2, &1, String, List<&1, String & Json.Val> & Choice>:
        r : Maybe<&2, U32> <- Pj.read.opt(~U32, ~Color.read_json, v)
        return (rest, Choice.set.pick.color(r, m))

def Choice.jf.color(st: List<&1, String & Json.Val> & Choice) -> Result<&2, &1, String, List<&1, String & Json.Val> & Choice>:
  match st:
    case Tuple{kvs, m}:
      Choice.jf.color.k(Pj.take(kvs, "color", "color"), m)

def Choice.jf.raw.k(t: Json.Val & List<&1, String & Json.Val>, m: Choice) -> Result<&2, &1, String, List<&1, String & Json.Val> & Choice>:
  match t:
    case Tuple{v, rest}:
      do Result<&2, &1, String, List<&1, String & Json.Val> & Choice>:
        r : Maybe<&2, List<&2, U32>> <- Pj.read.opt(~List<&2, U32>, ~Pj.read.bytes, v)
        return (rest, Choice.set.pick.raw(r, m))

def Choice.jf.raw(st: List<&1, String & Json.Val> & Choice) -> Result<&2, &1, String, List<&1, String & Json.Val> & Choice>:
  match st:
    case Tuple{kvs, m}:
      Choice.jf.raw.k(Pj.take(kvs, "raw", "raw"), m)

def Choice.jf.finish(st: List<&1, String & Json.Val> & Choice) -> Choice:
  match st:
    case Tuple{kvs, m}:
      m

def Choice.from_json(v: Json.Val) -> Result<&2, &1, String, Choice>:
  do Result<&2, &1, String, Choice>:
    kvs : List<&1, String & Json.Val> <- Pj.fields(v)
    s1 : List<&1, String & Json.Val> & Choice <- Choice.jf.tag((kvs, Choice.default()))
    s2 : List<&1, String & Json.Val> & Choice <- Choice.jf.number(s1)
    s3 : List<&1, String & Json.Val> & Choice <- Choice.jf.text(s2)
    s4 : List<&1, String & Json.Val> & Choice <- Choice.jf.scalars(s3)
    s5 : List<&1, String & Json.Val> & Choice <- Choice.jf.color(s4)
    s6 : List<&1, String & Json.Val> & Choice <- Choice.jf.raw(s5)
    return Choice.jf.finish(s6)

def Choice.encode_json(m: Choice) -> Bytes.Bytes:
  Pj.encode(Choice.to_json(m))

def Choice.decode_json(b: Bytes.Bytes) -> Result<&2, &1, String, Choice>:
  do Result<&2, &1, String, Choice>:
    v : Json.Val <- Pj.parse(b)
    Choice.from_json(v)

def Choice.encode(+codec: P.Codec, m: Choice) -> Bytes.Bytes:
  match codec:
    case P.Json{}:
      Choice.encode_json(m)
    case P.Proto{}:
      Choice.encode_proto(m)
    case P.Custom{name}:
      Bytes.new(0)

def Choice.decode(+codec: P.Codec, b: Bytes.Bytes) -> Result<&1, &1, E.Error, Choice>:
  match codec:
    case P.Json{}:
      lift_error(Choice, Choice.decode_json(b))
    case P.Proto{}:
      lift_error(Choice, Choice.decode_proto(b))
    case P.Custom{name}:
      Fail{E.new(Code.Unimplemented{}, "codec not supported: " ++ name)}

# ---------------------------------------------------------------- message Optionals

def Optionals.default() -> Optionals:
  Optionals{None{}, None{}, None{}, None{}, None{}, 0, None{}, None{}, None{}}

def Optionals.apply.maybe_int(v: Pb.Value, m: Optionals) -> Result<&2, &1, String, Optionals>:
  match m:
    case Optionals{_, f_maybe_string, f_maybe_bool, f_maybe_color, f_maybe_long, f_plain, f_maybe_msg, f_maybe_bytes, f_maybe_double}:
      do Result<&2, &1, String, Optionals>:
        r : U32 <- Pbr.read.int32(v)
        return Optionals{Some{r}, f_maybe_string, f_maybe_bool, f_maybe_color, f_maybe_long, f_plain, f_maybe_msg, f_maybe_bytes, f_maybe_double}

def Optionals.apply.maybe_string(v: Pb.Value, m: Optionals) -> Result<&2, &1, String, Optionals>:
  match m:
    case Optionals{f_maybe_int, _, f_maybe_bool, f_maybe_color, f_maybe_long, f_plain, f_maybe_msg, f_maybe_bytes, f_maybe_double}:
      do Result<&2, &1, String, Optionals>:
        r : String <- Pbr.read.string(v)
        return Optionals{f_maybe_int, Some{r}, f_maybe_bool, f_maybe_color, f_maybe_long, f_plain, f_maybe_msg, f_maybe_bytes, f_maybe_double}

def Optionals.apply.maybe_bool(v: Pb.Value, m: Optionals) -> Result<&2, &1, String, Optionals>:
  match m:
    case Optionals{f_maybe_int, f_maybe_string, _, f_maybe_color, f_maybe_long, f_plain, f_maybe_msg, f_maybe_bytes, f_maybe_double}:
      do Result<&2, &1, String, Optionals>:
        r : Bool <- Pbr.read.bool(v)
        return Optionals{f_maybe_int, f_maybe_string, Some{r}, f_maybe_color, f_maybe_long, f_plain, f_maybe_msg, f_maybe_bytes, f_maybe_double}

def Optionals.apply.maybe_color(v: Pb.Value, m: Optionals) -> Result<&2, &1, String, Optionals>:
  match m:
    case Optionals{f_maybe_int, f_maybe_string, f_maybe_bool, _, f_maybe_long, f_plain, f_maybe_msg, f_maybe_bytes, f_maybe_double}:
      do Result<&2, &1, String, Optionals>:
        r : U32 <- Pbr.read.enum(v)
        return Optionals{f_maybe_int, f_maybe_string, f_maybe_bool, Some{r}, f_maybe_long, f_plain, f_maybe_msg, f_maybe_bytes, f_maybe_double}

def Optionals.apply.maybe_long(v: Pb.Value, m: Optionals) -> Result<&2, &1, String, Optionals>:
  match m:
    case Optionals{f_maybe_int, f_maybe_string, f_maybe_bool, f_maybe_color, _, f_plain, f_maybe_msg, f_maybe_bytes, f_maybe_double}:
      do Result<&2, &1, String, Optionals>:
        r : Pb.Word64 <- Pbr.read.int64(v)
        return Optionals{f_maybe_int, f_maybe_string, f_maybe_bool, f_maybe_color, Some{r}, f_plain, f_maybe_msg, f_maybe_bytes, f_maybe_double}

def Optionals.apply.plain(v: Pb.Value, m: Optionals) -> Result<&2, &1, String, Optionals>:
  match m:
    case Optionals{f_maybe_int, f_maybe_string, f_maybe_bool, f_maybe_color, f_maybe_long, _, f_maybe_msg, f_maybe_bytes, f_maybe_double}:
      do Result<&2, &1, String, Optionals>:
        r : U32 <- Pbr.read.int32(v)
        return Optionals{f_maybe_int, f_maybe_string, f_maybe_bool, f_maybe_color, f_maybe_long, r, f_maybe_msg, f_maybe_bytes, f_maybe_double}

def Optionals.attach.maybe_msg(sub: Scalars, m: Optionals) -> Optionals:
  match m:
    case Optionals{f_maybe_int, f_maybe_string, f_maybe_bool, f_maybe_color, f_maybe_long, f_plain, _, f_maybe_bytes, f_maybe_double}:
      Optionals{f_maybe_int, f_maybe_string, f_maybe_bool, f_maybe_color, f_maybe_long, f_plain, Some{sub}, f_maybe_bytes, f_maybe_double}

def Optionals.apply.maybe_bytes(v: Pb.Value, m: Optionals) -> Result<&2, &1, String, Optionals>:
  match m:
    case Optionals{f_maybe_int, f_maybe_string, f_maybe_bool, f_maybe_color, f_maybe_long, f_plain, f_maybe_msg, _, f_maybe_double}:
      do Result<&2, &1, String, Optionals>:
        r : List<&2, U32> <- Pbr.read.bytes(v)
        return Optionals{f_maybe_int, f_maybe_string, f_maybe_bool, f_maybe_color, f_maybe_long, f_plain, f_maybe_msg, Some{r}, f_maybe_double}

def Optionals.apply.maybe_double(v: Pb.Value, m: Optionals) -> Result<&2, &1, String, Optionals>:
  match m:
    case Optionals{f_maybe_int, f_maybe_string, f_maybe_bool, f_maybe_color, f_maybe_long, f_plain, f_maybe_msg, f_maybe_bytes, _}:
      do Result<&2, &1, String, Optionals>:
        r : F32 <- Pbr.read.double(v)
        return Optionals{f_maybe_int, f_maybe_string, f_maybe_bool, f_maybe_color, f_maybe_long, f_plain, f_maybe_msg, f_maybe_bytes, Some{r}}

def Optionals.dec(+fuel: Nat, fields: List<&1, Pb.Field>, acc: Optionals) -> Result<&2, &1, String, Optionals>:
  match fuel:
    case 0n:
      Fail{"message nesting too deep"}
    case 1n+p:
      match fields:
        case Nil{}:
          Done{acc}
        case Con{Pb.Field{n, v}, rest}:
          match n:
            case 1:
              do Result<&2, &1, String, Optionals>:
                acc2 : Optionals <- Optionals.apply.maybe_int(v, acc)
                Optionals.dec(fuel, rest, acc2)
            case 2:
              do Result<&2, &1, String, Optionals>:
                acc2 : Optionals <- Optionals.apply.maybe_string(v, acc)
                Optionals.dec(fuel, rest, acc2)
            case 3:
              do Result<&2, &1, String, Optionals>:
                acc2 : Optionals <- Optionals.apply.maybe_bool(v, acc)
                Optionals.dec(fuel, rest, acc2)
            case 4:
              do Result<&2, &1, String, Optionals>:
                acc2 : Optionals <- Optionals.apply.maybe_color(v, acc)
                Optionals.dec(fuel, rest, acc2)
            case 5:
              do Result<&2, &1, String, Optionals>:
                acc2 : Optionals <- Optionals.apply.maybe_long(v, acc)
                Optionals.dec(fuel, rest, acc2)
            case 6:
              do Result<&2, &1, String, Optionals>:
                acc2 : Optionals <- Optionals.apply.plain(v, acc)
                Optionals.dec(fuel, rest, acc2)
            case 7:
              do Result<&2, &1, String, Optionals>:
                fs : List<&1, Pb.Field> <- Pbr.read.message(v)
                sub : Scalars <- Scalars.dec(p, fs, Scalars.default())
                Optionals.dec(fuel, rest, Optionals.attach.maybe_msg(sub, acc))
            case 8:
              do Result<&2, &1, String, Optionals>:
                acc2 : Optionals <- Optionals.apply.maybe_bytes(v, acc)
                Optionals.dec(fuel, rest, acc2)
            case 9:
              do Result<&2, &1, String, Optionals>:
                acc2 : Optionals <- Optionals.apply.maybe_double(v, acc)
                Optionals.dec(fuel, rest, acc2)
            case _:
              Optionals.dec(fuel, rest, acc)

def Optionals.decode_proto(b: Bytes.Bytes) -> Result<&2, &1, String, Optionals>:
  do Result<&2, &1, String, Optionals>:
    fs : List<&1, Pb.Field> <- Pbr.decode(b)
    Optionals.dec(100n, fs, Optionals.default())

def Optionals.f.maybe_int(x: Maybe<&2, U32>) -> List<&1, Pb.Field>:
  match x:
    case None{}:
      Nil{}
    case Some{s}:
      Pbr.field.int32.always(1, s)

def Optionals.f.maybe_string(x: Maybe<&2, String>) -> List<&1, Pb.Field>:
  match x:
    case None{}:
      Nil{}
    case Some{s}:
      Pbr.field.string.always(2, s)

def Optionals.f.maybe_bool(x: Maybe<&2, Bool>) -> List<&1, Pb.Field>:
  match x:
    case None{}:
      Nil{}
    case Some{s}:
      Pbr.field.bool.always(3, s)

def Optionals.f.maybe_color(x: Maybe<&2, U32>) -> List<&1, Pb.Field>:
  match x:
    case None{}:
      Nil{}
    case Some{s}:
      Pbr.field.enum.always(4, s)

def Optionals.f.maybe_long(x: Maybe<&2, Pb.Word64>) -> List<&1, Pb.Field>:
  match x:
    case None{}:
      Nil{}
    case Some{s}:
      Pbr.field.int64.always(5, s)

def Optionals.f.maybe_msg(x: Maybe<&2, Scalars>) -> List<&1, Pb.Field>:
  match x:
    case None{}:
      Nil{}
    case Some{s}:
      Pbr.field.message(7, Scalars.fields(s))

def Optionals.f.maybe_bytes(x: Maybe<&2, List<&2, U32>>) -> List<&1, Pb.Field>:
  match x:
    case None{}:
      Nil{}
    case Some{s}:
      Pbr.field.bytes.always(8, s)

def Optionals.f.maybe_double(x: Maybe<&2, F32>) -> List<&1, Pb.Field>:
  match x:
    case None{}:
      Nil{}
    case Some{s}:
      Pbr.field.double.always(9, s)

def Optionals.fields(m: Optionals) -> List<&1, Pb.Field>:
  match m:
    case Optionals{f_maybe_int, f_maybe_string, f_maybe_bool, f_maybe_color, f_maybe_long, f_plain, f_maybe_msg, f_maybe_bytes, f_maybe_double}:
      Pbr.cat.all([Optionals.f.maybe_int(f_maybe_int), Optionals.f.maybe_string(f_maybe_string), Optionals.f.maybe_bool(f_maybe_bool), Optionals.f.maybe_color(f_maybe_color), Optionals.f.maybe_long(f_maybe_long), Pbr.field.int32(6, f_plain), Optionals.f.maybe_msg(f_maybe_msg), Optionals.f.maybe_bytes(f_maybe_bytes), Optionals.f.maybe_double(f_maybe_double)])

def Optionals.encode_proto(m: Optionals) -> Bytes.Bytes:
  Pbr.encode(Optionals.fields(m))

def Optionals.set.maybe_int(x: Maybe<&2, U32>, m: Optionals) -> Optionals:
