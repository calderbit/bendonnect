def Maps.f.by_id(xs: List<&2, Maps.ByIdEntry>) -> List<&1, Pb.Field>:
  Pbr.field.repeated.message(2, Maps.f.by_id.items(xs))

def Maps.f.labels.items(xs: List<&2, Maps.LabelsEntry>) -> List<&1, List<&1, Pb.Field>>:
