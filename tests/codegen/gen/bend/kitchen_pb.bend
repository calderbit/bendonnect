      Pj.obj(Repeats.j.items(f_items, Pj.put.repeated.enum(~Color.name, "colors", f_colors, Pj.put.repeated.bool("flags", f_flags, Pj.put.repeated.double("doubles", f_doubles, Pj.put.repeated.int64("longs", f_longs, Pj.put.repeated.bytes("blobs", f_blobs, Pj.put.repeated.string("names", f_names, Pj.put.repeated.int32("unpackedInts", f_unpacked_ints, Pj.put.repeated.int32("packedInts", f_packed_ints, Nil{}))))))))))

