def Maps.f.blobs.items(xs: List<&2, Maps.BlobsEntry>) -> List<&1, List<&1, Pb.Field>>:
  match xs:
    case Nil{}:
      Nil{}
    case Con{h, t}:
      Con{Maps.BlobsEntry.fields(h), Maps.f.blobs.items(t)}

def Maps.f.blobs(xs: List<&2, Maps.BlobsEntry>) -> List<&1, Pb.Field>:
  Pbr.field.repeated.message(5, Maps.f.blobs.items(xs))

def Maps.f.colors.items(xs: List<&2, Maps.ColorsEntry>) -> List<&1, List<&1, Pb.Field>>:
  match xs:
    case Nil{}:
      Nil{}
    case Con{h, t}:
      Con{Maps.ColorsEntry.fields(h), Maps.f.colors.items(t)}

def Maps.f.colors(xs: List<&2, Maps.ColorsEntry>) -> List<&1, Pb.Field>:
  Pbr.field.repeated.message(6, Maps.f.colors.items(xs))

def Maps.fields(m: Maps) -> List<&1, Pb.Field>:
  match m:
    case Maps{f_counts, f_by_id, f_labels, f_flags, f_blobs, f_colors}:
      Pbr.cat.all([Maps.f.counts(f_counts), Maps.f.by_id(f_by_id), Maps.f.labels(f_labels), Maps.f.flags(f_flags), Maps.f.blobs(f_blobs), Maps.f.colors(f_colors)])

def Maps.encode_proto(m: Maps) -> Bytes.Bytes:
  Pbr.encode(Maps.fields(m))

def Maps.set.counts(x: List<&2, Maps.CountsEntry>, m: Maps) -> Maps:
  match m:
    case Maps{_, f_by_id, f_labels, f_flags, f_blobs, f_colors}:
      Maps{x, f_by_id, f_labels, f_flags, f_blobs, f_colors}

