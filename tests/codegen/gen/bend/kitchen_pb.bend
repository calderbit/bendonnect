  match m:
    case Kitchen{f_scalars, f_repeats, f_outer, f_tree, f_maps, f_choice, f_optionals, f_keywords}:
      Pj.obj(Kitchen.j.keywords(f_keywords, Kitchen.j.optionals(f_optionals, Kitchen.j.choice(f_choice, Kitchen.j.maps(f_maps, Kitchen.j.tree(f_tree, Kitchen.j.outer(f_outer, Kitchen.j.repeats(f_repeats, Kitchen.j.scalars(f_scalars, Nil{})))))))))

