  match t:
    case Tuple{v, rest}:
      do Result<&2, &1, String, List<&1, String & Json.Val> & Repeats>:
        r : List<&2, U32> <- Pj.read.repeated(~U32, ~Color.read_json, v)
        return (rest, Repeats.set.colors(r, m))

def Repeats.jf.colors(st: List<&1, String & Json.Val> & Repeats) -> Result<&2, &1, String, List<&1, String & Json.Val> & Repeats>:
  match st:
    case Tuple{kvs, m}:
      Repeats.jf.colors.k(Pj.take(kvs, "colors", "colors"), m)

def Repeats.jf.items.k(t: Json.Val & List<&1, String & Json.Val>, m: Repeats) -> Result<&2, &1, String, List<&1, String & Json.Val> & Repeats>:
  match t:
    case Tuple{v, rest}:
      do Result<&2, &1, String, List<&1, String & Json.Val> & Repeats>:
        r : List<&2, Scalars> <- Pj.read.repeated(~Scalars, ~Scalars.from_json, v)
        return (rest, Repeats.set.items(r, m))

def Repeats.jf.items(st: List<&1, String & Json.Val> & Repeats) -> Result<&2, &1, String, List<&1, String & Json.Val> & Repeats>:
  match st:
    case Tuple{kvs, m}:
      Repeats.jf.items.k(Pj.take(kvs, "items", "items"), m)

def Repeats.jf.finish(st: List<&1, String & Json.Val> & Repeats) -> Repeats:
  match st:
    case Tuple{kvs, m}:
      m

def Repeats.from_json(v: Json.Val) -> Result<&2, &1, String, Repeats>:
  do Result<&2, &1, String, Repeats>:
    kvs : List<&1, String & Json.Val> <- Pj.fields(v)
    s1 : List<&1, String & Json.Val> & Repeats <- Repeats.jf.packed_ints((kvs, Repeats.default()))
    s2 : List<&1, String & Json.Val> & Repeats <- Repeats.jf.unpacked_ints(s1)
    s3 : List<&1, String & Json.Val> & Repeats <- Repeats.jf.names(s2)
    s4 : List<&1, String & Json.Val> & Repeats <- Repeats.jf.blobs(s3)
    s5 : List<&1, String & Json.Val> & Repeats <- Repeats.jf.longs(s4)
    s6 : List<&1, String & Json.Val> & Repeats <- Repeats.jf.doubles(s5)
    s7 : List<&1, String & Json.Val> & Repeats <- Repeats.jf.flags(s6)
    s8 : List<&1, String & Json.Val> & Repeats <- Repeats.jf.colors(s7)
    s9 : List<&1, String & Json.Val> & Repeats <- Repeats.jf.items(s8)
    return Repeats.jf.finish(s9)

def Repeats.encode_json(m: Repeats) -> Bytes.Bytes:
  Pj.encode(Repeats.to_json(m))

def Repeats.decode_json(b: Bytes.Bytes) -> Result<&2, &1, String, Repeats>:
  do Result<&2, &1, String, Repeats>:
    v : Json.Val <- Pj.parse(b)
    Repeats.from_json(v)

def Repeats.encode(+codec: P.Codec, m: Repeats) -> Bytes.Bytes:
  match codec:
    case P.Json{}:
      Repeats.encode_json(m)
    case P.Proto{}:
      Repeats.encode_proto(m)
    case P.Custom{name}:
      Bytes.new(0)

def Repeats.decode(+codec: P.Codec, b: Bytes.Bytes) -> Result<&1, &1, E.Error, Repeats>:
  match codec:
    case P.Json{}:
      lift_error(Repeats, Repeats.decode_json(b))
    case P.Proto{}:
      lift_error(Repeats, Repeats.decode_proto(b))
    case P.Custom{name}:
      Fail{E.new(Code.Unimplemented{}, "codec not supported: " ++ name)}

# ---------------------------------------------------------------- message Outer.Inner

def Outer.Inner.default() -> Outer.Inner:
  Outer.Inner{"", 0}

def Outer.Inner.apply.label(v: Pb.Value, m: Outer.Inner) -> Result<&2, &1, String, Outer.Inner>:
  match m:
    case Outer.Inner{_, f_kind}:
      do Result<&2, &1, String, Outer.Inner>:
        r : String <- Pbr.read.string(v)
        return Outer.Inner{r, f_kind}

def Outer.Inner.apply.kind(v: Pb.Value, m: Outer.Inner) -> Result<&2, &1, String, Outer.Inner>:
  match m:
    case Outer.Inner{f_label, _}:
      do Result<&2, &1, String, Outer.Inner>:
        r : U32 <- Pbr.read.enum(v)
        return Outer.Inner{f_label, r}

def Outer.Inner.dec(+fuel: Nat, fields: List<&1, Pb.Field>, acc: Outer.Inner) -> Result<&2, &1, String, Outer.Inner>:
  match fuel:
    case 0n:
      Fail{"message nesting too deep"}
    case 1n+p:
      match fields:
        case Nil{}:
          Done{acc}
        case Con{Pb.Field{n, v}, rest}:
          match n:
            case 1:
              do Result<&2, &1, String, Outer.Inner>:
                acc2 : Outer.Inner <- Outer.Inner.apply.label(v, acc)
                Outer.Inner.dec(fuel, rest, acc2)
            case 2:
              do Result<&2, &1, String, Outer.Inner>:
                acc2 : Outer.Inner <- Outer.Inner.apply.kind(v, acc)
                Outer.Inner.dec(fuel, rest, acc2)
            case _:
              Outer.Inner.dec(fuel, rest, acc)

def Outer.Inner.decode_proto(b: Bytes.Bytes) -> Result<&2, &1, String, Outer.Inner>:
  do Result<&2, &1, String, Outer.Inner>:
    fs : List<&1, Pb.Field> <- Pbr.decode(b)
    Outer.Inner.dec(100n, fs, Outer.Inner.default())

def Outer.Inner.fields(m: Outer.Inner) -> List<&1, Pb.Field>:
  match m:
    case Outer.Inner{f_label, f_kind}:
      Pbr.cat.all([Pbr.field.string(1, f_label), Pbr.field.enum(2, f_kind)])

def Outer.Inner.encode_proto(m: Outer.Inner) -> Bytes.Bytes:
  Pbr.encode(Outer.Inner.fields(m))

def Outer.Inner.set.label(x: String, m: Outer.Inner) -> Outer.Inner:
  match m:
    case Outer.Inner{_, f_kind}:
      Outer.Inner{x, f_kind}

def Outer.Inner.set.kind(x: U32, m: Outer.Inner) -> Outer.Inner:
  match m:
    case Outer.Inner{f_label, _}:
      Outer.Inner{f_label, x}

def Outer.Inner.to_json(m: Outer.Inner) -> Json.Val:
  match m:
    case Outer.Inner{f_label, f_kind}:
      Pj.obj(Pj.put.enum(~Outer.Kind_.name, "kind", f_kind, Pj.put.string("label", f_label, Nil{})))

def Outer.Inner.jf.label.k(t: Json.Val & List<&1, String & Json.Val>, m: Outer.Inner) -> Result<&2, &1, String, List<&1, String & Json.Val> & Outer.Inner>:
  match t:
    case Tuple{v, rest}:
      do Result<&2, &1, String, List<&1, String & Json.Val> & Outer.Inner>:
        r : String <- Pj.read.string(v)
        return (rest, Outer.Inner.set.label(r, m))

def Outer.Inner.jf.label(st: List<&1, String & Json.Val> & Outer.Inner) -> Result<&2, &1, String, List<&1, String & Json.Val> & Outer.Inner>:
  match st:
    case Tuple{kvs, m}:
      Outer.Inner.jf.label.k(Pj.take(kvs, "label", "label"), m)

def Outer.Inner.jf.kind.k(t: Json.Val & List<&1, String & Json.Val>, m: Outer.Inner) -> Result<&2, &1, String, List<&1, String & Json.Val> & Outer.Inner>:
  match t:
    case Tuple{v, rest}:
      do Result<&2, &1, String, List<&1, String & Json.Val> & Outer.Inner>:
        r : U32 <- Outer.Kind_.read_json(v)
        return (rest, Outer.Inner.set.kind(r, m))

def Outer.Inner.jf.kind(st: List<&1, String & Json.Val> & Outer.Inner) -> Result<&2, &1, String, List<&1, String & Json.Val> & Outer.Inner>:
  match st:
    case Tuple{kvs, m}:
      Outer.Inner.jf.kind.k(Pj.take(kvs, "kind", "kind"), m)

def Outer.Inner.jf.finish(st: List<&1, String & Json.Val> & Outer.Inner) -> Outer.Inner:
  match st:
    case Tuple{kvs, m}:
      m

def Outer.Inner.from_json(v: Json.Val) -> Result<&2, &1, String, Outer.Inner>:
  do Result<&2, &1, String, Outer.Inner>:
    kvs : List<&1, String & Json.Val> <- Pj.fields(v)
    s1 : List<&1, String & Json.Val> & Outer.Inner <- Outer.Inner.jf.label((kvs, Outer.Inner.default()))
    s2 : List<&1, String & Json.Val> & Outer.Inner <- Outer.Inner.jf.kind(s1)
    return Outer.Inner.jf.finish(s2)

def Outer.Inner.encode_json(m: Outer.Inner) -> Bytes.Bytes:
  Pj.encode(Outer.Inner.to_json(m))

def Outer.Inner.decode_json(b: Bytes.Bytes) -> Result<&2, &1, String, Outer.Inner>:
  do Result<&2, &1, String, Outer.Inner>:
    v : Json.Val <- Pj.parse(b)
    Outer.Inner.from_json(v)

def Outer.Inner.encode(+codec: P.Codec, m: Outer.Inner) -> Bytes.Bytes:
  match codec:
    case P.Json{}:
      Outer.Inner.encode_json(m)
    case P.Proto{}:
      Outer.Inner.encode_proto(m)
    case P.Custom{name}:
      Bytes.new(0)

def Outer.Inner.decode(+codec: P.Codec, b: Bytes.Bytes) -> Result<&1, &1, E.Error, Outer.Inner>:
  match codec:
    case P.Json{}:
      lift_error(Outer.Inner, Outer.Inner.decode_json(b))
    case P.Proto{}:
      lift_error(Outer.Inner, Outer.Inner.decode_proto(b))
    case P.Custom{name}:
      Fail{E.new(Code.Unimplemented{}, "codec not supported: " ++ name)}

# ---------------------------------------------------------------- message Outer

def Outer.default() -> Outer:
  Outer{None{}, 0, 0, Nil{}}

def Outer.attach.inner(sub: Outer.Inner, m: Outer) -> Outer:
  match m:
    case Outer{_, f_kind, f_color, f_inners}:
      Outer{Some{sub}, f_kind, f_color, f_inners}

def Outer.apply.kind(v: Pb.Value, m: Outer) -> Result<&2, &1, String, Outer>:
  match m:
    case Outer{f_inner, _, f_color, f_inners}:
      do Result<&2, &1, String, Outer>:
        r : U32 <- Pbr.read.enum(v)
        return Outer{f_inner, r, f_color, f_inners}

def Outer.apply.color(v: Pb.Value, m: Outer) -> Result<&2, &1, String, Outer>:
  match m:
    case Outer{f_inner, f_kind, _, f_inners}:
      do Result<&2, &1, String, Outer>:
        r : U32 <- Pbr.read.enum(v)
        return Outer{f_inner, f_kind, r, f_inners}

def Outer.attach.inners(sub: Outer.Inner, m: Outer) -> Outer:
  match m:
    case Outer{f_inner, f_kind, f_color, f_inners}:
      Outer{f_inner, f_kind, f_color, Con{sub, f_inners}}

def Outer.finish(m: Outer) -> Outer:
  match m:
    case Outer{f_inner, f_kind, f_color, f_inners}:
      Outer{f_inner, f_kind, f_color, Pbr.rev(Outer.Inner, f_inners)}

def Outer.dec(+fuel: Nat, fields: List<&1, Pb.Field>, acc: Outer) -> Result<&2, &1, String, Outer>:
  match fuel:
    case 0n:
      Fail{"message nesting too deep"}
    case 1n+p:
      match fields:
        case Nil{}:
          Done{Outer.finish(acc)}
        case Con{Pb.Field{n, v}, rest}:
          match n:
            case 1:
              do Result<&2, &1, String, Outer>:
                fs : List<&1, Pb.Field> <- Pbr.read.message(v)
                sub : Outer.Inner <- Outer.Inner.dec(p, fs, Outer.Inner.default())
                Outer.dec(fuel, rest, Outer.attach.inner(sub, acc))
            case 2:
              do Result<&2, &1, String, Outer>:
                acc2 : Outer <- Outer.apply.kind(v, acc)
                Outer.dec(fuel, rest, acc2)
            case 3:
              do Result<&2, &1, String, Outer>:
                acc2 : Outer <- Outer.apply.color(v, acc)
                Outer.dec(fuel, rest, acc2)
            case 4:
              do Result<&2, &1, String, Outer>:
                fs : List<&1, Pb.Field> <- Pbr.read.message(v)
                sub : Outer.Inner <- Outer.Inner.dec(p, fs, Outer.Inner.default())
                Outer.dec(fuel, rest, Outer.attach.inners(sub, acc))
            case _:
              Outer.dec(fuel, rest, acc)

def Outer.decode_proto(b: Bytes.Bytes) -> Result<&2, &1, String, Outer>:
  do Result<&2, &1, String, Outer>:
    fs : List<&1, Pb.Field> <- Pbr.decode(b)
    Outer.dec(100n, fs, Outer.default())

def Outer.f.inner(x: Maybe<&2, Outer.Inner>) -> List<&1, Pb.Field>:
  match x:
    case None{}:
      Nil{}
    case Some{s}:
      Pbr.field.message(1, Outer.Inner.fields(s))

def Outer.f.inners.items(xs: List<&2, Outer.Inner>) -> List<&1, List<&1, Pb.Field>>:
  match xs:
    case Nil{}:
      Nil{}
    case Con{h, t}:
      Con{Outer.Inner.fields(h), Outer.f.inners.items(t)}

def Outer.f.inners(xs: List<&2, Outer.Inner>) -> List<&1, Pb.Field>:
  Pbr.field.repeated.message(4, Outer.f.inners.items(xs))

def Outer.fields(m: Outer) -> List<&1, Pb.Field>:
  match m:
    case Outer{f_inner, f_kind, f_color, f_inners}:
      Pbr.cat.all([Outer.f.inner(f_inner), Pbr.field.enum(2, f_kind), Pbr.field.enum(3, f_color), Outer.f.inners(f_inners)])

def Outer.encode_proto(m: Outer) -> Bytes.Bytes:
  Pbr.encode(Outer.fields(m))

def Outer.set.inner(x: Maybe<&2, Outer.Inner>, m: Outer) -> Outer:
  match m:
    case Outer{_, f_kind, f_color, f_inners}:
      Outer{x, f_kind, f_color, f_inners}

def Outer.set.kind(x: U32, m: Outer) -> Outer:
  match m:
    case Outer{f_inner, _, f_color, f_inners}:
      Outer{f_inner, x, f_color, f_inners}

def Outer.set.color(x: U32, m: Outer) -> Outer:
  match m:
    case Outer{f_inner, f_kind, _, f_inners}:
      Outer{f_inner, f_kind, x, f_inners}

def Outer.set.inners(x: List<&2, Outer.Inner>, m: Outer) -> Outer:
  match m:
    case Outer{f_inner, f_kind, f_color, _}:
      Outer{f_inner, f_kind, f_color, x}

def Outer.j.inner(x: Maybe<&2, Outer.Inner>, acc: List<&1, Bytes.Bytes & Json.Val>) -> List<&1, Bytes.Bytes & Json.Val>:
  match x:
    case None{}:
      acc
    case Some{s}:
      Pj.put.message("inner", Outer.Inner.to_json(s), acc)

def Outer.j.inners.items(xs: List<&2, Outer.Inner>) -> List<&1, Json.Val>:
  match xs:
    case Nil{}:
      Nil{}
    case Con{h, t}:
      Con{Outer.Inner.to_json(h), Outer.j.inners.items(t)}

def Outer.j.inners(xs: List<&2, Outer.Inner>, acc: List<&1, Bytes.Bytes & Json.Val>) -> List<&1, Bytes.Bytes & Json.Val>:
  Pj.put.repeated.message("inners", Outer.j.inners.items(xs), acc)

def Outer.to_json(m: Outer) -> Json.Val:
  match m:
    case Outer{f_inner, f_kind, f_color, f_inners}:
      Pj.obj(Outer.j.inners(f_inners, Pj.put.enum(~Color.name, "color", f_color, Pj.put.enum(~Outer.Kind_.name, "kind", f_kind, Outer.j.inner(f_inner, Nil{})))))

def Outer.jf.inner.k(t: Json.Val & List<&1, String & Json.Val>, m: Outer) -> Result<&2, &1, String, List<&1, String & Json.Val> & Outer>:
  match t:
    case Tuple{v, rest}:
      do Result<&2, &1, String, List<&1, String & Json.Val> & Outer>:
        r : Maybe<&2, Outer.Inner> <- Pj.read.opt(~Outer.Inner, ~Outer.Inner.from_json, v)
        return (rest, Outer.set.inner(r, m))

def Outer.jf.inner(st: List<&1, String & Json.Val> & Outer) -> Result<&2, &1, String, List<&1, String & Json.Val> & Outer>:
  match st:
    case Tuple{kvs, m}:
      Outer.jf.inner.k(Pj.take(kvs, "inner", "inner"), m)

def Outer.jf.kind.k(t: Json.Val & List<&1, String & Json.Val>, m: Outer) -> Result<&2, &1, String, List<&1, String & Json.Val> & Outer>:
  match t:
    case Tuple{v, rest}:
      do Result<&2, &1, String, List<&1, String & Json.Val> & Outer>:
        r : U32 <- Outer.Kind_.read_json(v)
        return (rest, Outer.set.kind(r, m))

def Outer.jf.kind(st: List<&1, String & Json.Val> & Outer) -> Result<&2, &1, String, List<&1, String & Json.Val> & Outer>:
  match st:
    case Tuple{kvs, m}:
      Outer.jf.kind.k(Pj.take(kvs, "kind", "kind"), m)

def Outer.jf.color.k(t: Json.Val & List<&1, String & Json.Val>, m: Outer) -> Result<&2, &1, String, List<&1, String & Json.Val> & Outer>:
  match t:
    case Tuple{v, rest}:
      do Result<&2, &1, String, List<&1, String & Json.Val> & Outer>:
        r : U32 <- Color.read_json(v)
        return (rest, Outer.set.color(r, m))

def Outer.jf.color(st: List<&1, String & Json.Val> & Outer) -> Result<&2, &1, String, List<&1, String & Json.Val> & Outer>:
  match st:
    case Tuple{kvs, m}:
      Outer.jf.color.k(Pj.take(kvs, "color", "color"), m)

def Outer.jf.inners.k(t: Json.Val & List<&1, String & Json.Val>, m: Outer) -> Result<&2, &1, String, List<&1, String & Json.Val> & Outer>:
  match t:
    case Tuple{v, rest}:
      do Result<&2, &1, String, List<&1, String & Json.Val> & Outer>:
        r : List<&2, Outer.Inner> <- Pj.read.repeated(~Outer.Inner, ~Outer.Inner.from_json, v)
        return (rest, Outer.set.inners(r, m))

def Outer.jf.inners(st: List<&1, String & Json.Val> & Outer) -> Result<&2, &1, String, List<&1, String & Json.Val> & Outer>:
  match st:
    case Tuple{kvs, m}:
      Outer.jf.inners.k(Pj.take(kvs, "inners", "inners"), m)

def Outer.jf.finish(st: List<&1, String & Json.Val> & Outer) -> Outer:
  match st:
    case Tuple{kvs, m}:
      m

def Outer.from_json(v: Json.Val) -> Result<&2, &1, String, Outer>:
  do Result<&2, &1, String, Outer>:
    kvs : List<&1, String & Json.Val> <- Pj.fields(v)
    s1 : List<&1, String & Json.Val> & Outer <- Outer.jf.inner((kvs, Outer.default()))
    s2 : List<&1, String & Json.Val> & Outer <- Outer.jf.kind(s1)
    s3 : List<&1, String & Json.Val> & Outer <- Outer.jf.color(s2)
    s4 : List<&1, String & Json.Val> & Outer <- Outer.jf.inners(s3)
    return Outer.jf.finish(s4)

def Outer.encode_json(m: Outer) -> Bytes.Bytes:
  Pj.encode(Outer.to_json(m))

def Outer.decode_json(b: Bytes.Bytes) -> Result<&2, &1, String, Outer>:
  do Result<&2, &1, String, Outer>:
    v : Json.Val <- Pj.parse(b)
    Outer.from_json(v)

def Outer.encode(+codec: P.Codec, m: Outer) -> Bytes.Bytes:
  match codec:
    case P.Json{}:
      Outer.encode_json(m)
    case P.Proto{}:
      Outer.encode_proto(m)
    case P.Custom{name}:
      Bytes.new(0)

def Outer.decode(+codec: P.Codec, b: Bytes.Bytes) -> Result<&1, &1, E.Error, Outer>:
  match codec:
    case P.Json{}:
      lift_error(Outer, Outer.decode_json(b))
    case P.Proto{}:
      lift_error(Outer, Outer.decode_proto(b))
    case P.Custom{name}:
      Fail{E.new(Code.Unimplemented{}, "codec not supported: " ++ name)}

# ---------------------------------------------------------------- message Tree

def Tree.default() -> Tree:
  Tree{"", 0, None{}, None{}, Nil{}}

def Tree.apply.name(v: Pb.Value, m: Tree) -> Result<&2, &1, String, Tree>:
  match m:
    case Tree{_, f_weight, f_left, f_right, f_children}:
      do Result<&2, &1, String, Tree>:
        r : String <- Pbr.read.string(v)
        return Tree{r, f_weight, f_left, f_right, f_children}

def Tree.apply.weight(v: Pb.Value, m: Tree) -> Result<&2, &1, String, Tree>:
  match m:
    case Tree{f_name, _, f_left, f_right, f_children}:
      do Result<&2, &1, String, Tree>:
        r : U32 <- Pbr.read.int32(v)
        return Tree{f_name, r, f_left, f_right, f_children}

def Tree.attach.left(sub: Tree, m: Tree) -> Tree:
  match m:
    case Tree{f_name, f_weight, _, f_right, f_children}:
      Tree{f_name, f_weight, Some{sub}, f_right, f_children}

def Tree.attach.right(sub: Tree, m: Tree) -> Tree:
  match m:
    case Tree{f_name, f_weight, f_left, _, f_children}:
      Tree{f_name, f_weight, f_left, Some{sub}, f_children}

def Tree.attach.children(sub: Tree, m: Tree) -> Tree:
  match m:
    case Tree{f_name, f_weight, f_left, f_right, f_children}:
      Tree{f_name, f_weight, f_left, f_right, Con{sub, f_children}}

def Tree.finish(m: Tree) -> Tree:
  match m:
    case Tree{f_name, f_weight, f_left, f_right, f_children}:
      Tree{f_name, f_weight, f_left, f_right, Pbr.rev(Tree, f_children)}

def Tree.dec(+fuel: Nat, fields: List<&1, Pb.Field>, acc: Tree) -> Result<&2, &1, String, Tree>:
  match fuel:
    case 0n:
      Fail{"message nesting too deep"}
    case 1n+p:
      match fields:
        case Nil{}:
          Done{Tree.finish(acc)}
        case Con{Pb.Field{n, v}, rest}:
          match n:
            case 1:
              do Result<&2, &1, String, Tree>:
                acc2 : Tree <- Tree.apply.name(v, acc)
                Tree.dec(fuel, rest, acc2)
            case 2:
              do Result<&2, &1, String, Tree>:
                acc2 : Tree <- Tree.apply.weight(v, acc)
                Tree.dec(fuel, rest, acc2)
            case 3:
              do Result<&2, &1, String, Tree>:
                fs : List<&1, Pb.Field> <- Pbr.read.message(v)
                sub : Tree <- Tree.dec(p, fs, Tree.default())
                Tree.dec(fuel, rest, Tree.attach.left(sub, acc))
            case 4:
              do Result<&2, &1, String, Tree>:
                fs : List<&1, Pb.Field> <- Pbr.read.message(v)
                sub : Tree <- Tree.dec(p, fs, Tree.default())
                Tree.dec(fuel, rest, Tree.attach.right(sub, acc))
            case 5:
              do Result<&2, &1, String, Tree>:
                fs : List<&1, Pb.Field> <- Pbr.read.message(v)
                sub : Tree <- Tree.dec(p, fs, Tree.default())
                Tree.dec(fuel, rest, Tree.attach.children(sub, acc))
            case _:
              Tree.dec(fuel, rest, acc)

def Tree.decode_proto(b: Bytes.Bytes) -> Result<&2, &1, String, Tree>:
  do Result<&2, &1, String, Tree>:
    fs : List<&1, Pb.Field> <- Pbr.decode(b)
    Tree.dec(100n, fs, Tree.default())

def Tree.src.left(x: Maybe<&2, Tree>) -> List<&2, Tree>:
  match x:
    case None{}:
      Nil{}
    case Some{s}:
      Con{s, Nil{}}

def Tree.src.right(x: Maybe<&2, Tree>) -> List<&2, Tree>:
  match x:
    case None{}:
      Nil{}
    case Some{s}:
      Con{s, Nil{}}

def Tree.enc_all(+fuel: Nat, ms: List<&2, Tree>) -> List<&1, List<&1, Pb.Field>>:
  match fuel:
    case 0n:
      Nil{}
    case 1n+p:
      match ms:
        case Nil{}:
          Nil{}
        case Con{+x, rest}:
          match x:
            case Tree{f_name, f_weight, f_left, f_right, f_children}:
              k_left k_right k_children = Tree.enc_all(p, Tree.src.left(f_left)) Tree.enc_all(p, Tree.src.right(f_right)) Tree.enc_all(p, f_children)
              Con{Pbr.cat.all([Pbr.field.string(1, f_name), Pbr.field.int32(2, f_weight), Pbr.field.repeated.message(3, k_left), Pbr.field.repeated.message(4, k_right), Pbr.field.repeated.message(5, k_children)]), Tree.enc_all(fuel, rest)}

def Tree.fields.first(xs: List<&1, List<&1, Pb.Field>>) -> List<&1, Pb.Field>:
  match xs:
    case Nil{}:
      Nil{}
    case Con{h, t}:
      h

def Tree.fields(m: Tree) -> List<&1, Pb.Field>:
  Tree.fields.first(Tree.enc_all(100n, Con{m, Nil{}}))

def Tree.encode_proto(m: Tree) -> Bytes.Bytes:
  Pbr.encode(Tree.fields(m))

def Tree.set.name(x: String, m: Tree) -> Tree:
  match m:
    case Tree{_, f_weight, f_left, f_right, f_children}:
      Tree{x, f_weight, f_left, f_right, f_children}

def Tree.set.weight(x: U32, m: Tree) -> Tree:
  match m:
    case Tree{f_name, _, f_left, f_right, f_children}:
      Tree{f_name, x, f_left, f_right, f_children}

def Tree.set.left(x: Maybe<&2, Tree>, m: Tree) -> Tree:
  match m:
    case Tree{f_name, f_weight, _, f_right, f_children}:
      Tree{f_name, f_weight, x, f_right, f_children}

def Tree.set.right(x: Maybe<&2, Tree>, m: Tree) -> Tree:
  match m:
    case Tree{f_name, f_weight, f_left, _, f_children}:
      Tree{f_name, f_weight, f_left, x, f_children}

def Tree.set.children(x: List<&2, Tree>, m: Tree) -> Tree:
  match m:
    case Tree{f_name, f_weight, f_left, f_right, _}:
      Tree{f_name, f_weight, f_left, f_right, x}

def Tree.jput.one(name: String, ks: List<&1, Json.Val>, acc: List<&1, Bytes.Bytes & Json.Val>) -> List<&1, Bytes.Bytes & Json.Val>:
  match ks:
    case Nil{}:
      acc
    case Con{v, t}:
      Pj.put.message(name, v, acc)

def Tree.tj_all(+fuel: Nat, ms: List<&2, Tree>) -> List<&1, Json.Val>:
  match fuel:
    case 0n:
      Nil{}
    case 1n+p:
      match ms:
        case Nil{}:
          Nil{}
        case Con{+x, rest}:
          match x:
            case Tree{f_name, f_weight, f_left, f_right, f_children}:
              k_left k_right k_children = Tree.tj_all(p, Tree.src.left(f_left)) Tree.tj_all(p, Tree.src.right(f_right)) Tree.tj_all(p, f_children)
              Con{Pj.obj(Pj.put.repeated.message("children", k_children, Tree.jput.one("right", k_right, Tree.jput.one("left", k_left, Pj.put.int32("weight", f_weight, Pj.put.string("name", f_name, Nil{})))))), Tree.tj_all(fuel, rest)}

def Tree.tj.first(xs: List<&1, Json.Val>) -> Json.Val:
  match xs:
    case Nil{}:
      Pj.obj(Nil{})
    case Con{h, t}:
      h

def Tree.to_json(m: Tree) -> Json.Val:
  Tree.tj.first(Tree.tj_all(100n, Con{m, Nil{}}))

def Tree.first(ms: List<&2, Tree>) -> Maybe<&2, Tree>:
  match ms:
    case Nil{}:
      None{}
    case Con{h, t}:
      Some{h}

def Tree.head(ms: List<&2, Tree>) -> Tree:
  match ms:
    case Nil{}:
      Tree.default()
    case Con{h, t}:
      h

def Tree.jf.name.k(t: Json.Val & List<&1, String & Json.Val>, m: Tree) -> Result<&2, &1, String, List<&1, String & Json.Val> & Tree>:
  match t:
    case Tuple{v, rest}:
      do Result<&2, &1, String, List<&1, String & Json.Val> & Tree>:
        r : String <- Pj.read.string(v)
        return (rest, Tree.set.name(r, m))

def Tree.jf.name(st: List<&1, String & Json.Val> & Tree) -> Result<&2, &1, String, List<&1, String & Json.Val> & Tree>:
  match st:
    case Tuple{kvs, m}:
      Tree.jf.name.k(Pj.take(kvs, "name", "name"), m)

def Tree.jf.weight.k(t: Json.Val & List<&1, String & Json.Val>, m: Tree) -> Result<&2, &1, String, List<&1, String & Json.Val> & Tree>:
  match t:
    case Tuple{v, rest}:
      do Result<&2, &1, String, List<&1, String & Json.Val> & Tree>:
        r : U32 <- Pj.read.int32(v)
        return (rest, Tree.set.weight(r, m))

def Tree.jf.weight(st: List<&1, String & Json.Val> & Tree) -> Result<&2, &1, String, List<&1, String & Json.Val> & Tree>:
  match st:
    case Tuple{kvs, m}:
      Tree.jf.weight.k(Pj.take(kvs, "weight", "weight"), m)

def Tree.jf.left.k(rec: List<&1, Json.Val> -> Result<&2, &1, String, List<&2, Tree>>, t: Json.Val & List<&1, String & Json.Val>, m: Tree) -> Result<&2, &1, String, List<&1, String & Json.Val> & Tree>:
  match t:
    case Tuple{v, rest}:
      do Result<&2, &1, String, List<&1, String & Json.Val> & Tree>:
        ms : List<&2, Tree> <- rec(json_single(v))
        return (rest, Tree.set.left(Tree.first(ms), m))

def Tree.jf.left(rec: List<&1, Json.Val> -> Result<&2, &1, String, List<&2, Tree>>, st: List<&1, String & Json.Val> & Tree) -> Result<&2, &1, String, List<&1, String & Json.Val> & Tree>:
  match st:
    case Tuple{kvs, m}:
      Tree.jf.left.k(rec, Pj.take(kvs, "left", "left"), m)

def Tree.jf.right.k(rec: List<&1, Json.Val> -> Result<&2, &1, String, List<&2, Tree>>, t: Json.Val & List<&1, String & Json.Val>, m: Tree) -> Result<&2, &1, String, List<&1, String & Json.Val> & Tree>:
  match t:
    case Tuple{v, rest}:
      do Result<&2, &1, String, List<&1, String & Json.Val> & Tree>:
        ms : List<&2, Tree> <- rec(json_single(v))
        return (rest, Tree.set.right(Tree.first(ms), m))

def Tree.jf.right(rec: List<&1, Json.Val> -> Result<&2, &1, String, List<&2, Tree>>, st: List<&1, String & Json.Val> & Tree) -> Result<&2, &1, String, List<&1, String & Json.Val> & Tree>:
  match st:
    case Tuple{kvs, m}:
      Tree.jf.right.k(rec, Pj.take(kvs, "right", "right"), m)

def Tree.jf.children.k(rec: List<&1, Json.Val> -> Result<&2, &1, String, List<&2, Tree>>, t: Json.Val & List<&1, String & Json.Val>, m: Tree) -> Result<&2, &1, String, List<&1, String & Json.Val> & Tree>:
  match t:
    case Tuple{v, rest}:
      do Result<&2, &1, String, List<&1, String & Json.Val> & Tree>:
        vs : List<&1, Json.Val> <- json_items(v)
        ms : List<&2, Tree> <- rec(vs)
        return (rest, Tree.set.children(ms, m))

def Tree.jf.children(rec: List<&1, Json.Val> -> Result<&2, &1, String, List<&2, Tree>>, st: List<&1, String & Json.Val> & Tree) -> Result<&2, &1, String, List<&1, String & Json.Val> & Tree>:
  match st:
    case Tuple{kvs, m}:
      Tree.jf.children.k(rec, Pj.take(kvs, "children", "children"), m)

def Tree.jf.finish(st: List<&1, String & Json.Val> & Tree) -> Tree:
  match st:
    case Tuple{kvs, m}:
      m

def Tree.fj_all(+fuel: Nat, vs: List<&1, Json.Val>) -> Result<&2, &1, String, List<&2, Tree>>:
  match fuel:
    case 0n:
      Fail{"message nesting too deep"}
    case 1n+p:
      match vs:
        case Nil{}:
          Done{Nil{}}
        case Con{v, rest}:
          do Result<&2, &1, String, List<&2, Tree>>:
            kvs : List<&1, String & Json.Val> <- Pj.fields(v)
            s1 : List<&1, String & Json.Val> & Tree <- Tree.jf.name((kvs, Tree.default()))
            s2 : List<&1, String & Json.Val> & Tree <- Tree.jf.weight(s1)
            s3 : List<&1, String & Json.Val> & Tree <- Tree.jf.left(xs => Tree.fj_all(p, xs), s2)
            s4 : List<&1, String & Json.Val> & Tree <- Tree.jf.right(xs => Tree.fj_all(p, xs), s3)
            s5 : List<&1, String & Json.Val> & Tree <- Tree.jf.children(xs => Tree.fj_all(p, xs), s4)
            tail : List<&2, Tree> <- Tree.fj_all(fuel, rest)
            return Con{Tree.jf.finish(s5), tail}

def Tree.from_json(v: Json.Val) -> Result<&2, &1, String, Tree>:
  do Result<&2, &1, String, Tree>:
    ms : List<&2, Tree> <- Tree.fj_all(100n, Con{v, Nil{}})
    return Tree.head(ms)

def Tree.encode_json(m: Tree) -> Bytes.Bytes:
  Pj.encode(Tree.to_json(m))

def Tree.decode_json(b: Bytes.Bytes) -> Result<&2, &1, String, Tree>:
  do Result<&2, &1, String, Tree>:
    v : Json.Val <- Pj.parse(b)
    Tree.from_json(v)

def Tree.encode(+codec: P.Codec, m: Tree) -> Bytes.Bytes:
  match codec:
    case P.Json{}:
      Tree.encode_json(m)
    case P.Proto{}:
      Tree.encode_proto(m)
    case P.Custom{name}:
      Bytes.new(0)

def Tree.decode(+codec: P.Codec, b: Bytes.Bytes) -> Result<&1, &1, E.Error, Tree>:
  match codec:
    case P.Json{}:
      lift_error(Tree, Tree.decode_json(b))
    case P.Proto{}:
      lift_error(Tree, Tree.decode_proto(b))
    case P.Custom{name}:
      Fail{E.new(Code.Unimplemented{}, "codec not supported: " ++ name)}

# ---------------------------------------------------------------- message Maps.CountsEntry

def Maps.CountsEntry.default() -> Maps.CountsEntry:
  Maps.CountsEntry{"", Pb.Word64{0, 0}}

def Maps.CountsEntry.mk(+k: String, +v: Pb.Word64) -> Maps.CountsEntry:
  Maps.CountsEntry{k, v}

def Maps.CountsEntry.apply.key(v: Pb.Value, m: Maps.CountsEntry) -> Result<&2, &1, String, Maps.CountsEntry>:
  match m:
    case Maps.CountsEntry{_, f_value}:
      do Result<&2, &1, String, Maps.CountsEntry>:
        r : String <- Pbr.read.string(v)
        return Maps.CountsEntry{r, f_value}

def Maps.CountsEntry.apply.value(v: Pb.Value, m: Maps.CountsEntry) -> Result<&2, &1, String, Maps.CountsEntry>:
  match m:
    case Maps.CountsEntry{f_key, _}:
      do Result<&2, &1, String, Maps.CountsEntry>:
        r : Pb.Word64 <- Pbr.read.int64(v)
        return Maps.CountsEntry{f_key, r}

def Maps.CountsEntry.dec(+fuel: Nat, fields: List<&1, Pb.Field>, acc: Maps.CountsEntry) -> Result<&2, &1, String, Maps.CountsEntry>:
  match fuel:
    case 0n:
      Fail{"message nesting too deep"}
    case 1n+p:
      match fields:
        case Nil{}:
          Done{acc}
        case Con{Pb.Field{n, v}, rest}:
          match n:
            case 1:
              do Result<&2, &1, String, Maps.CountsEntry>:
                acc2 : Maps.CountsEntry <- Maps.CountsEntry.apply.key(v, acc)
                Maps.CountsEntry.dec(fuel, rest, acc2)
            case 2:
              do Result<&2, &1, String, Maps.CountsEntry>:
                acc2 : Maps.CountsEntry <- Maps.CountsEntry.apply.value(v, acc)
                Maps.CountsEntry.dec(fuel, rest, acc2)
            case _:
              Maps.CountsEntry.dec(fuel, rest, acc)

def Maps.CountsEntry.fields(m: Maps.CountsEntry) -> List<&1, Pb.Field>:
  match m:
    case Maps.CountsEntry{f_key, f_value}:
      Pbr.cat.all([Pbr.field.string.always(1, f_key), Pbr.field.int64.always(2, f_value)])

