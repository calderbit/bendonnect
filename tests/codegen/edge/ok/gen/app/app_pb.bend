def Event_.jf.level.k(t: Json.Val & List<&1, String & Json.Val>, m: Event_) -> Result<&2, &1, String, List<&1, String & Json.Val> & Event_>:
  match t:
    case Tuple{v, rest}:
      do Result<&2, &1, String, List<&1, String & Json.Val> & Event_>:
        r : U32 <- shared_v1_common.Level.read_json(v)
        return (rest, Event_.set.level(r, m))

def Event_.jf.level(st: List<&1, String & Json.Val> & Event_) -> Result<&2, &1, String, List<&1, String & Json.Val> & Event_>:
  match st:
    case Tuple{kvs, m}:
      Event_.jf.level.k(Pj.take(kvs, "level", "level"), m)

def Event_.jf.history.k(t: Json.Val & List<&1, String & Json.Val>, m: Event_) -> Result<&2, &1, String, List<&1, String & Json.Val> & Event_>:
  match t:
    case Tuple{v, rest}:
      do Result<&2, &1, String, List<&1, String & Json.Val> & Event_>:
        r : List<&2, shared_v1_common.Stamp> <- Pj.read.repeated(~shared_v1_common.Stamp, ~shared_v1_common.Stamp.from_json, v)
        return (rest, Event_.set.history(r, m))

def Event_.jf.history(st: List<&1, String & Json.Val> & Event_) -> Result<&2, &1, String, List<&1, String & Json.Val> & Event_>:
  match st:
    case Tuple{kvs, m}:
      Event_.jf.history.k(Pj.take(kvs, "history", "history"), m)

def Event_.jf.marks.k(t: Json.Val & List<&1, String & Json.Val>, m: Event_) -> Result<&2, &1, String, List<&1, String & Json.Val> & Event_>:
  match t:
    case Tuple{v, rest}:
      do Result<&2, &1, String, List<&1, String & Json.Val> & Event_>:
        r : List<&2, Event_.MarksEntry> <- Pj.read.map(~String, ~shared_v1_common.Stamp, ~Event_.MarksEntry, ~Pj.read.key.string, ~shared_v1_common.Stamp.from_json, ~Event_.MarksEntry.mk, v)
        return (rest, Event_.set.marks(r, m))

def Event_.jf.marks(st: List<&1, String & Json.Val> & Event_) -> Result<&2, &1, String, List<&1, String & Json.Val> & Event_>:
  match st:
    case Tuple{kvs, m}:
      Event_.jf.marks.k(Pj.take(kvs, "marks", "marks"), m)

def Event_.jf.nothing.k(t: Json.Val & List<&1, String & Json.Val>, m: Event_) -> Result<&2, &1, String, List<&1, String & Json.Val> & Event_>:
  match t:
    case Tuple{v, rest}:
      do Result<&2, &1, String, List<&1, String & Json.Val> & Event_>:
        r : Maybe<&2, Empty_> <- Pj.read.opt(~Empty_, ~Empty_.from_json, v)
        return (rest, Event_.set.nothing(r, m))

def Event_.jf.nothing(st: List<&1, String & Json.Val> & Event_) -> Result<&2, &1, String, List<&1, String & Json.Val> & Event_>:
  match st:
    case Tuple{kvs, m}:
      Event_.jf.nothing.k(Pj.take(kvs, "nothing", "nothing"), m)

def Event_.jf.kind.k(t: Json.Val & List<&1, String & Json.Val>, m: Event_) -> Result<&2, &1, String, List<&1, String & Json.Val> & Event_>:
  match t:
    case Tuple{v, rest}:
      do Result<&2, &1, String, List<&1, String & Json.Val> & Event_>:
        r : Maybe<&2, Kind_> <- Pj.read.opt(~Kind_, ~Kind_.from_json, v)
        return (rest, Event_.set.kind(r, m))

def Event_.jf.kind(st: List<&1, String & Json.Val> & Event_) -> Result<&2, &1, String, List<&1, String & Json.Val> & Event_>:
  match st:
    case Tuple{kvs, m}:
      Event_.jf.kind.k(Pj.take(kvs, "kind", "kind"), m)

def Event_.jf.finish(st: List<&1, String & Json.Val> & Event_) -> Event_:
  match st:
    case Tuple{kvs, m}:
      m

def Event_.from_json(v: Json.Val) -> Result<&2, &1, String, Event_>:
  do Result<&2, &1, String, Event_>:
    kvs : List<&1, String & Json.Val> <- Pj.fields(v)
    s1 : List<&1, String & Json.Val> & Event_ <- Event_.jf.at((kvs, Event_.default()))
    s2 : List<&1, String & Json.Val> & Event_ <- Event_.jf.level(s1)
    s3 : List<&1, String & Json.Val> & Event_ <- Event_.jf.history(s2)
    s4 : List<&1, String & Json.Val> & Event_ <- Event_.jf.marks(s3)
    s5 : List<&1, String & Json.Val> & Event_ <- Event_.jf.nothing(s4)
    s6 : List<&1, String & Json.Val> & Event_ <- Event_.jf.kind(s5)
    return Event_.jf.finish(s6)

def Event_.encode_json(m: Event_) -> Bytes.Bytes:
  Pj.encode(Event_.to_json(m))

def Event_.decode_json(b: Bytes.Bytes) -> Result<&2, &1, String, Event_>:
  do Result<&2, &1, String, Event_>:
    v : Json.Val <- Pj.parse(b)
    Event_.from_json(v)

def Event_.encode(+codec: P.Codec, m: Event_) -> Bytes.Bytes:
  match codec:
    case P.Json{}:
      Event_.encode_json(m)
    case P.Proto{}:
      Event_.encode_proto(m)
    case P.Custom{name}:
      Bytes.new(0)

def Event_.decode(+codec: P.Codec, b: Bytes.Bytes) -> Result<&1, &1, E.Error, Event_>:
  match codec:
    case P.Json{}:
      lift_error(Event_, Event_.decode_json(b))
    case P.Proto{}:
      lift_error(Event_, Event_.decode_proto(b))
    case P.Custom{name}:
      Fail{E.new(Code.Unimplemented{}, "codec not supported: " ++ name)}

# ---------------------------------------------------------------- message Expr.Binary

def Expr.Binary.default() -> Expr.Binary:
  Expr.Binary{"", 0}

def Expr.Binary.apply.op(v: Pb.Value, m: Expr.Binary) -> Result<&2, &1, String, Expr.Binary>:
  match m:
    case Expr.Binary{_, f_weight}:
      do Result<&2, &1, String, Expr.Binary>:
        r : String <- Pbr.read.string(v)
        return Expr.Binary{r, f_weight}

def Expr.Binary.apply.weight(v: Pb.Value, m: Expr.Binary) -> Result<&2, &1, String, Expr.Binary>:
  match m:
    case Expr.Binary{f_op, _}:
      do Result<&2, &1, String, Expr.Binary>:
        r : U32 <- Pbr.read.int32(v)
        return Expr.Binary{f_op, r}

def Expr.Binary.dec(+fuel: Nat, fields: List<&1, Pb.Field>, acc: Expr.Binary) -> Result<&2, &1, String, Expr.Binary>:
  match fuel:
    case 0n:
      Fail{"message nesting too deep"}
    case 1n+p:
      match fields:
        case Nil{}:
          Done{acc}
        case Con{Pb.Field{n, v}, rest}:
          match n:
            case 1:
              do Result<&2, &1, String, Expr.Binary>:
                acc2 : Expr.Binary <- Expr.Binary.apply.op(v, acc)
                Expr.Binary.dec(fuel, rest, acc2)
            case 2:
              do Result<&2, &1, String, Expr.Binary>:
                acc2 : Expr.Binary <- Expr.Binary.apply.weight(v, acc)
                Expr.Binary.dec(fuel, rest, acc2)
            case _:
              Expr.Binary.dec(fuel, rest, acc)

def Expr.Binary.decode_proto(b: Bytes.Bytes) -> Result<&2, &1, String, Expr.Binary>:
  do Result<&2, &1, String, Expr.Binary>:
    fs : List<&1, Pb.Field> <- Pbr.decode(b)
    Expr.Binary.dec(100n, fs, Expr.Binary.default())

def Expr.Binary.fields(m: Expr.Binary) -> List<&1, Pb.Field>:
  match m:
    case Expr.Binary{f_op, f_weight}:
      Pbr.cat.all([Pbr.field.string(1, f_op), Pbr.field.int32(2, f_weight)])

def Expr.Binary.encode_proto(m: Expr.Binary) -> Bytes.Bytes:
  Pbr.encode(Expr.Binary.fields(m))

def Expr.Binary.set.op(x: String, m: Expr.Binary) -> Expr.Binary:
  match m:
    case Expr.Binary{_, f_weight}:
      Expr.Binary{x, f_weight}

def Expr.Binary.set.weight(x: U32, m: Expr.Binary) -> Expr.Binary:
  match m:
    case Expr.Binary{f_op, _}:
      Expr.Binary{f_op, x}

def Expr.Binary.to_json(m: Expr.Binary) -> Json.Val:
  match m:
    case Expr.Binary{f_op, f_weight}:
      Pj.obj(Pj.put.int32("weight", f_weight, Pj.put.string("op", f_op, Nil{})))

def Expr.Binary.jf.op.k(t: Json.Val & List<&1, String & Json.Val>, m: Expr.Binary) -> Result<&2, &1, String, List<&1, String & Json.Val> & Expr.Binary>:
  match t:
    case Tuple{v, rest}:
      do Result<&2, &1, String, List<&1, String & Json.Val> & Expr.Binary>:
        r : String <- Pj.read.string(v)
        return (rest, Expr.Binary.set.op(r, m))

def Expr.Binary.jf.op(st: List<&1, String & Json.Val> & Expr.Binary) -> Result<&2, &1, String, List<&1, String & Json.Val> & Expr.Binary>:
  match st:
    case Tuple{kvs, m}:
      Expr.Binary.jf.op.k(Pj.take(kvs, "op", "op"), m)

def Expr.Binary.jf.weight.k(t: Json.Val & List<&1, String & Json.Val>, m: Expr.Binary) -> Result<&2, &1, String, List<&1, String & Json.Val> & Expr.Binary>:
  match t:
    case Tuple{v, rest}:
      do Result<&2, &1, String, List<&1, String & Json.Val> & Expr.Binary>:
        r : U32 <- Pj.read.int32(v)
        return (rest, Expr.Binary.set.weight(r, m))

def Expr.Binary.jf.weight(st: List<&1, String & Json.Val> & Expr.Binary) -> Result<&2, &1, String, List<&1, String & Json.Val> & Expr.Binary>:
  match st:
    case Tuple{kvs, m}:
      Expr.Binary.jf.weight.k(Pj.take(kvs, "weight", "weight"), m)

def Expr.Binary.jf.finish(st: List<&1, String & Json.Val> & Expr.Binary) -> Expr.Binary:
  match st:
    case Tuple{kvs, m}:
      m

def Expr.Binary.from_json(v: Json.Val) -> Result<&2, &1, String, Expr.Binary>:
  do Result<&2, &1, String, Expr.Binary>:
    kvs : List<&1, String & Json.Val> <- Pj.fields(v)
    s1 : List<&1, String & Json.Val> & Expr.Binary <- Expr.Binary.jf.op((kvs, Expr.Binary.default()))
    s2 : List<&1, String & Json.Val> & Expr.Binary <- Expr.Binary.jf.weight(s1)
    return Expr.Binary.jf.finish(s2)

def Expr.Binary.encode_json(m: Expr.Binary) -> Bytes.Bytes:
  Pj.encode(Expr.Binary.to_json(m))

def Expr.Binary.decode_json(b: Bytes.Bytes) -> Result<&2, &1, String, Expr.Binary>:
  do Result<&2, &1, String, Expr.Binary>:
    v : Json.Val <- Pj.parse(b)
    Expr.Binary.from_json(v)

def Expr.Binary.encode(+codec: P.Codec, m: Expr.Binary) -> Bytes.Bytes:
  match codec:
    case P.Json{}:
      Expr.Binary.encode_json(m)
    case P.Proto{}:
      Expr.Binary.encode_proto(m)
    case P.Custom{name}:
      Bytes.new(0)

def Expr.Binary.decode(+codec: P.Codec, b: Bytes.Bytes) -> Result<&1, &1, E.Error, Expr.Binary>:
  match codec:
    case P.Json{}:
      lift_error(Expr.Binary, Expr.Binary.decode_json(b))
    case P.Proto{}:
      lift_error(Expr.Binary, Expr.Binary.decode_proto(b))
    case P.Custom{name}:
      Fail{E.new(Code.Unimplemented{}, "codec not supported: " ++ name)}

# ---------------------------------------------------------------- message Expr

def Expr.default() -> Expr:
  Expr{Expr.Node.None{}}

def Expr.apply.literal(v: Pb.Value, m: Expr) -> Result<&2, &1, String, Expr>:
  match m:
    case Expr{_}:
      do Result<&2, &1, String, Expr>:
        r : U32 <- Pbr.read.int32(v)
        return Expr{Expr.Node.Literal{r}}

def Expr.apply.name(v: Pb.Value, m: Expr) -> Result<&2, &1, String, Expr>:
  match m:
    case Expr{_}:
      do Result<&2, &1, String, Expr>:
        r : String <- Pbr.read.string(v)
        return Expr{Expr.Node.Name{r}}

def Expr.attach.binary(sub: Expr.Binary, m: Expr) -> Expr:
  match m:
    case Expr{_}:
      Expr{Expr.Node.Binary{sub}}

def Expr.attach.negated(sub: Expr, m: Expr) -> Expr:
  match m:
    case Expr{_}:
      Expr{Expr.Node.Negated{sub}}

def Expr.dec(+fuel: Nat, fields: List<&1, Pb.Field>, acc: Expr) -> Result<&2, &1, String, Expr>:
  match fuel:
    case 0n:
      Fail{"message nesting too deep"}
    case 1n+p:
      match fields:
        case Nil{}:
          Done{acc}
        case Con{Pb.Field{n, v}, rest}:
          match n:
            case 1:
              do Result<&2, &1, String, Expr>:
                acc2 : Expr <- Expr.apply.literal(v, acc)
                Expr.dec(fuel, rest, acc2)
            case 2:
              do Result<&2, &1, String, Expr>:
                acc2 : Expr <- Expr.apply.name(v, acc)
                Expr.dec(fuel, rest, acc2)
            case 3:
              do Result<&2, &1, String, Expr>:
                fs : List<&1, Pb.Field> <- Pbr.read.message(v)
                sub : Expr.Binary <- Expr.Binary.dec(p, fs, Expr.Binary.default())
                Expr.dec(fuel, rest, Expr.attach.binary(sub, acc))
            case 4:
              do Result<&2, &1, String, Expr>:
                fs : List<&1, Pb.Field> <- Pbr.read.message(v)
                sub : Expr <- Expr.dec(p, fs, Expr.default())
                Expr.dec(fuel, rest, Expr.attach.negated(sub, acc))
            case _:
              Expr.dec(fuel, rest, acc)

def Expr.decode_proto(b: Bytes.Bytes) -> Result<&2, &1, String, Expr>:
  do Result<&2, &1, String, Expr>:
    fs : List<&1, Pb.Field> <- Pbr.decode(b)
    Expr.dec(100n, fs, Expr.default())

def Expr.src.node(o: Expr.Node) -> List<&2, Expr>:
  match o:
    case Expr.Node.Negated{s}:
      Con{s, Nil{}}
    case _:
      Nil{}

def Expr.put.node(o: Expr.Node, k: List<&1, List<&1, Pb.Field>>) -> List<&1, Pb.Field>:
  match o:
    case Expr.Node.None{}:
      Nil{}
    case Expr.Node.Literal{s}:
      Pbr.field.int32.always(1, s)
    case Expr.Node.Name{s}:
      Pbr.field.string.always(2, s)
    case Expr.Node.Binary{s}:
      Pbr.field.message(3, Expr.Binary.fields(s))
    case Expr.Node.Negated{s}:
      Pbr.field.repeated.message(4, k)

def Expr.enc_all(+fuel: Nat, ms: List<&2, Expr>) -> List<&1, List<&1, Pb.Field>>:
  match fuel:
    case 0n:
      Nil{}
    case 1n+p:
      match ms:
        case Nil{}:
          Nil{}
        case Con{+x, rest}:
          match x:
            case Expr{f_node}:
              k_node = Expr.enc_all(p, Expr.src.node(f_node))
              Con{Pbr.cat.all([Expr.put.node(f_node, k_node)]), Expr.enc_all(fuel, rest)}

def Expr.fields.first(xs: List<&1, List<&1, Pb.Field>>) -> List<&1, Pb.Field>:
  match xs:
    case Nil{}:
      Nil{}
    case Con{h, t}:
      h

def Expr.fields(m: Expr) -> List<&1, Pb.Field>:
  Expr.fields.first(Expr.enc_all(100n, Con{m, Nil{}}))

def Expr.encode_proto(m: Expr) -> Bytes.Bytes:
  Pbr.encode(Expr.fields(m))

def Expr.set.node(x: Expr.Node, m: Expr) -> Expr:
  match m:
    case Expr{_}:
      Expr{x}

def Expr.set.pick.literal(r: Maybe<&2, U32>, m: Expr) -> Expr:
  match r:
    case None{}:
      m
    case Some{x}:
      Expr.set.node(Expr.Node.Literal{x}, m)

def Expr.set.pick.name(r: Maybe<&2, String>, m: Expr) -> Expr:
  match r:
    case None{}:
      m
    case Some{x}:
      Expr.set.node(Expr.Node.Name{x}, m)

def Expr.set.pick.binary(r: Maybe<&2, Expr.Binary>, m: Expr) -> Expr:
  match r:
    case None{}:
      m
    case Some{x}:
      Expr.set.node(Expr.Node.Binary{x}, m)

def Expr.set.pick.negated(r: Maybe<&2, Expr>, m: Expr) -> Expr:
  match r:
    case None{}:
      m
    case Some{x}:
      Expr.set.node(Expr.Node.Negated{x}, m)

def Expr.jput.one(name: String, ks: List<&1, Json.Val>, acc: List<&1, Bytes.Bytes & Json.Val>) -> List<&1, Bytes.Bytes & Json.Val>:
  match ks:
    case Nil{}:
      acc
    case Con{v, t}:
      Pj.put.message(name, v, acc)

def Expr.jput.node(o: Expr.Node, k: List<&1, Json.Val>, acc: List<&1, Bytes.Bytes & Json.Val>) -> List<&1, Bytes.Bytes & Json.Val>:
  match o:
    case Expr.Node.None{}:
      acc
    case Expr.Node.Literal{s}:
      Pj.put.int32.always("literal", s, acc)
    case Expr.Node.Name{s}:
      Pj.put.string.always("name", s, acc)
    case Expr.Node.Binary{s}:
      Pj.put.message("binary", Expr.Binary.to_json(s), acc)
    case Expr.Node.Negated{s}:
      Expr.jput.one("negated", k, acc)

def Expr.tj_all(+fuel: Nat, ms: List<&2, Expr>) -> List<&1, Json.Val>:
  match fuel:
    case 0n:
      Nil{}
    case 1n+p:
      match ms:
        case Nil{}:
          Nil{}
        case Con{+x, rest}:
          match x:
            case Expr{f_node}:
              k_node = Expr.tj_all(p, Expr.src.node(f_node))
              Con{Pj.obj(Expr.jput.node(f_node, k_node, Nil{})), Expr.tj_all(fuel, rest)}

def Expr.tj.first(xs: List<&1, Json.Val>) -> Json.Val:
  match xs:
    case Nil{}:
      Pj.obj(Nil{})
    case Con{h, t}:
      h

def Expr.to_json(m: Expr) -> Json.Val:
  Expr.tj.first(Expr.tj_all(100n, Con{m, Nil{}}))

def Expr.first(ms: List<&2, Expr>) -> Maybe<&2, Expr>:
  match ms:
    case Nil{}:
      None{}
    case Con{h, t}:
      Some{h}

def Expr.head(ms: List<&2, Expr>) -> Expr:
  match ms:
    case Nil{}:
      Expr.default()
    case Con{h, t}:
      h

def Expr.jf.literal.k(t: Json.Val & List<&1, String & Json.Val>, m: Expr) -> Result<&2, &1, String, List<&1, String & Json.Val> & Expr>:
  match t:
    case Tuple{v, rest}:
      do Result<&2, &1, String, List<&1, String & Json.Val> & Expr>:
        r : Maybe<&2, U32> <- Pj.read.opt(~U32, ~Pj.read.int32, v)
        return (rest, Expr.set.pick.literal(r, m))

def Expr.jf.literal(st: List<&1, String & Json.Val> & Expr) -> Result<&2, &1, String, List<&1, String & Json.Val> & Expr>:
  match st:
    case Tuple{kvs, m}:
      Expr.jf.literal.k(Pj.take(kvs, "literal", "literal"), m)

def Expr.jf.name.k(t: Json.Val & List<&1, String & Json.Val>, m: Expr) -> Result<&2, &1, String, List<&1, String & Json.Val> & Expr>:
  match t:
    case Tuple{v, rest}:
      do Result<&2, &1, String, List<&1, String & Json.Val> & Expr>:
        r : Maybe<&2, String> <- Pj.read.opt(~String, ~Pj.read.string, v)
        return (rest, Expr.set.pick.name(r, m))

def Expr.jf.name(st: List<&1, String & Json.Val> & Expr) -> Result<&2, &1, String, List<&1, String & Json.Val> & Expr>:
  match st:
    case Tuple{kvs, m}:
      Expr.jf.name.k(Pj.take(kvs, "name", "name"), m)

def Expr.jf.binary.k(t: Json.Val & List<&1, String & Json.Val>, m: Expr) -> Result<&2, &1, String, List<&1, String & Json.Val> & Expr>:
  match t:
    case Tuple{v, rest}:
      do Result<&2, &1, String, List<&1, String & Json.Val> & Expr>:
        r : Maybe<&2, Expr.Binary> <- Pj.read.opt(~Expr.Binary, ~Expr.Binary.from_json, v)
        return (rest, Expr.set.pick.binary(r, m))

def Expr.jf.binary(st: List<&1, String & Json.Val> & Expr) -> Result<&2, &1, String, List<&1, String & Json.Val> & Expr>:
  match st:
    case Tuple{kvs, m}:
      Expr.jf.binary.k(Pj.take(kvs, "binary", "binary"), m)

def Expr.jf.negated.k(rec: List<&1, Json.Val> -> Result<&2, &1, String, List<&2, Expr>>, t: Json.Val & List<&1, String & Json.Val>, m: Expr) -> Result<&2, &1, String, List<&1, String & Json.Val> & Expr>:
  match t:
    case Tuple{v, rest}:
      do Result<&2, &1, String, List<&1, String & Json.Val> & Expr>:
        ms : List<&2, Expr> <- rec(json_single(v))
        return (rest, Expr.set.pick.negated(Expr.first(ms), m))

def Expr.jf.negated(rec: List<&1, Json.Val> -> Result<&2, &1, String, List<&2, Expr>>, st: List<&1, String & Json.Val> & Expr) -> Result<&2, &1, String, List<&1, String & Json.Val> & Expr>:
  match st:
    case Tuple{kvs, m}:
      Expr.jf.negated.k(rec, Pj.take(kvs, "negated", "negated"), m)

def Expr.jf.finish(st: List<&1, String & Json.Val> & Expr) -> Expr:
  match st:
    case Tuple{kvs, m}:
      m

def Expr.fj_all(+fuel: Nat, vs: List<&1, Json.Val>) -> Result<&2, &1, String, List<&2, Expr>>:
  match fuel:
    case 0n:
      Fail{"message nesting too deep"}
    case 1n+p:
      match vs:
        case Nil{}:
          Done{Nil{}}
        case Con{v, rest}:
          do Result<&2, &1, String, List<&2, Expr>>:
            kvs : List<&1, String & Json.Val> <- Pj.fields(v)
            s1 : List<&1, String & Json.Val> & Expr <- Expr.jf.literal((kvs, Expr.default()))
            s2 : List<&1, String & Json.Val> & Expr <- Expr.jf.name(s1)
            s3 : List<&1, String & Json.Val> & Expr <- Expr.jf.binary(s2)
            s4 : List<&1, String & Json.Val> & Expr <- Expr.jf.negated(xs => Expr.fj_all(p, xs), s3)
            tail : List<&2, Expr> <- Expr.fj_all(fuel, rest)
            return Con{Expr.jf.finish(s4), tail}

def Expr.from_json(v: Json.Val) -> Result<&2, &1, String, Expr>:
  do Result<&2, &1, String, Expr>:
    ms : List<&2, Expr> <- Expr.fj_all(100n, Con{v, Nil{}})
    return Expr.head(ms)

def Expr.encode_json(m: Expr) -> Bytes.Bytes:
  Pj.encode(Expr.to_json(m))

def Expr.decode_json(b: Bytes.Bytes) -> Result<&2, &1, String, Expr>:
  do Result<&2, &1, String, Expr>:
    v : Json.Val <- Pj.parse(b)
    Expr.from_json(v)

def Expr.encode(+codec: P.Codec, m: Expr) -> Bytes.Bytes:
  match codec:
    case P.Json{}:
      Expr.encode_json(m)
    case P.Proto{}:
      Expr.encode_proto(m)
    case P.Custom{name}:
      Bytes.new(0)

def Expr.decode(+codec: P.Codec, b: Bytes.Bytes) -> Result<&1, &1, E.Error, Expr>:
  match codec:
    case P.Json{}:
      lift_error(Expr, Expr.decode_json(b))
    case P.Proto{}:
      lift_error(Expr, Expr.decode_proto(b))
    case P.Custom{name}:
      Fail{E.new(Code.Unimplemented{}, "codec not supported: " ++ name)}
